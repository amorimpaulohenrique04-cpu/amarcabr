      "settings": {
        "custom_liquid": "<div class=\"bundle-selector\" style=\"margin-bottom: 20px; padding: 15px; border: 1px solid #e8e8e8; border-radius: 4px;\">\n  <h4 style=\"margin-top:0;\">Personalize seu Combo:</h4>\n\n  {% assign combo_products = product.metafields.custom.combo_products.value %}\n  \n  {% for item in combo_products %}\n    <div class=\"combo-item\" style=\"margin-bottom: 15px;\">\n      <label style=\"display:block; font-weight:bold; margin-bottom:5px;\">{{ item.title }}:</label>\n      <select class=\"combo-variant-select\" data-product-title=\"{{ item.title }}\" style=\"width:100%; padding: 8px; border: 1px solid #ccc;\">\n        {% for variant in item.variants %}\n          {% if variant.available %}\n            <option value=\"{{ variant.id }}\">{{ variant.title }} - {{ variant.price | money }}</option>\n          {% else %}\n            <option disabled>{{ variant.title }} - Esgotado</option>\n          {% endif %}\n        {% endfor %}\n      </select>\n    </div>\n  {% endfor %}\n\n  <input type=\"hidden\" name=\"id\" value=\"{{ product.selected_or_first_available_variant.id }}\">\n</div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  const form = document.querySelector('form[action=\"/cart/add\"]');\n  if (!form) return;\n\n  form.addEventListener('submit', function(e) {\n    e.preventDefault();\n    const selects = document.querySelectorAll('.combo-variant-select');\n    let items = [];\n    selects.forEach(select => { items.push({ id: select.value, quantity: 1 }); });\n    fetch(window.Shopify.routes.root + 'cart/add.js', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ 'items': items })\n    })\n    .then(response => { window.location.href = '/checkout'; })\n    .catch(error => console.error('Erro:', error));\n  });\n});\n</script>",
