{"sections":{"main":{"type":"main-page","blocks":{"page-content":{"type":"page-content","settings":{},"blocks":{}}},"block_order":["page-content"],"settings":{"content_direction":"column","gap":32,"color_scheme":"","padding-block-start":40,"padding-block-end":80}},"custom_liquid_FJXkgh":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<!-- section\/404-celestial.liquid -->\n<style>\n  .template-404-celestial {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    min-height: 80vh;\n    padding: 60px 20px;\n    text-align: center;\n    background: radial-gradient(circle at top, #ffffff 0%, #e0f2fe 100%);\n    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n    position: relative;\n    overflow: hidden;\n  }\n  .oops-text {\n    font-size: 200px;\n    font-weight: 900;\n    line-height: 1;\n    margin: 0;\n    background-image: url('https:\/\/images.unsplash.com\/photo-1513002749550-c59d786b8e6c?auto=format&fit=crop&q=80&w=2000');\n    background-size: cover;\n    background-position: center;\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    letter-spacing: -8px;\n    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.05));\n    position: relative;\n    z-index: 1;\n  }\n  .sub-heading {\n    font-size: 28px;\n    font-weight: 600;\n    color: #475569;\n    margin-top: 20px;\n    text-transform: uppercase;\n    letter-spacing: 4px;\n  }\n  .description {\n    font-size: 18px;\n    color: #64748b;\n    max-width: 550px;\n    margin: 24px auto;\n    line-height: 1.8;\n    font-style: italic;\n  }\n  .btn-heavenly {\n    display: inline-block;\n    padding: 16px 48px;\n    background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);\n    color: #ffffff !important;\n    text-decoration: none;\n    border-radius: 50px;\n    font-weight: 700;\n    font-size: 15px;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    box-shadow: 0 10px 25px rgba(217, 119, 6, 0.3);\n  }\n  .btn-heavenly:hover {\n    transform: translateY(-3px) scale(1.05);\n    box-shadow: 0 15px 30px rgba(217, 119, 6, 0.4);\n  }\n  @media (max-width: 768px) {\n    .oops-text { font-size: 110px; letter-spacing: -4px; }\n    .sub-heading { font-size: 20px; }\n  }\n<\/style>\n\n<div class=\"template-404-celestial\">\n  <h1 class=\"oops-text\">Oops!<\/h1>\n  <h2 class=\"sub-heading\">Caminho Não Encontrado<\/h2>\n  <p class=\"description\">\n    Nem todos os que vagam estão perdidos, mas esta página certamente está.\n  <\/p>\n \n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["main","custom_liquid_FJXkgh"]}