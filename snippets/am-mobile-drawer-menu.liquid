{%- comment -%}
  A MARCA — Mobile Drawer Menu (Horizon)
  - Uses existing drawer container from the theme
  - Only replaces the menu content
{%- endcomment -%}

{%- liquid
  assign menu = menu | default: section.settings.menu | default: linklists[settings.main_menu] 
-%}

<nav class="am-menu" aria-label="Menu">
  <ul class="am-menu__list" role="list">
    {%- for link in menu.links -%}
<li class="am-menu__item" style="--am-i: {{ forloop.index }};">
        {%- if link.links != blank -%}
          <details class="am-menu__details">
            <summary class="am-menu__summary">
              <span class="am-menu__label">{{ link.title }}</span>
              <span class="am-menu__chev" aria-hidden="true">
                <!-- chevron right -->
                <svg viewBox="0 0 20 20" width="18" height="18" focusable="false" aria-hidden="true">
                  <path d="M7.2 3.8a1 1 0 0 0 0 1.4L12 10l-4.8 4.8a1 1 0 1 0 1.4 1.4l5.5-5.5a1 1 0 0 0 0-1.4L8.6 3.8a1 1 0 0 0-1.4 0z" fill="currentColor"/>
                </svg>
              </span>
            </summary>

            <div class="am-menu__subwrap">
              <ul class="am-menu__sub" role="list">
                {%- for child in link.links -%}
<li class="am-menu__subitem" style="--am-j: {{ forloop.index }};">
                    <a class="am-menu__sublink" href="{{ child.url }}">{{ child.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </details>
        {%- else -%}
          <a class="am-menu__link" href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

   <div class="am-menu__divider" role="presentation"></div>

  <div class="am-menu__bottom">
    {%- comment -%} Sociais (mantém como está hoje) {%- endcomment -%}
    <div class="am-menu__social" aria-label="Redes sociais">
      <a class="am-menu__icon" href="#" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.2-1.5 1.6-1.5h1.7V5a23 23 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.4V11H7.6v3H10v8h3.5z"/></svg>
      </a>
      <a class="am-menu__icon" href="#" aria-label="YouTube">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21.6 7.2a3 3 0 0 0-2.1-2.1C17.7 4.6 12 4.6 12 4.6s-5.7 0-7.5.5A3 3 0 0 0 2.4 7.2 31.7 31.7 0 0 0 2 12a31.7 31.7 0 0 0 .4 4.8 3 3 0 0 0 2.1 2.1c1.8.5 7.5.5 7.5.5s5.7 0 7.5-.5a3 3 0 0 0 2.1-2.1A31.7 31.7 0 0 0 22 12a31.7 31.7 0 0 0-.4-4.8zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
      </a>
      <a class="am-menu__icon" href="#" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm-5 4.5A3.5 3.5 0 1 1 8.5 12 3.5 3.5 0 0 1 12 8.5zm0 2A1.5 1.5 0 1 0 13.5 12 1.5 1.5 0 0 0 12 10.5zM18 6.8a.7.7 0 1 1-.7-.7.7.7 0 0 1 .7.7z"/></svg>
      </a>
      <a class="am-menu__icon" href="#" aria-label="Snapchat">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2c2.6 0 4.7 2.1 4.7 4.7v4c0 .5.3 1 .8 1.2l.9.4c.7.3.6 1.3-.1 1.5l-1 .3c-.5.2-.9.6-1 1.1-.2 1.2-1.5 2.2-4.3 2.2s-4.1-1-4.3-2.2c-.1-.5-.5-.9-1-1.1l-1-.3c-.7-.2-.8-1.2-.1-1.5l.9-.4c.5-.2.8-.7.8-1.2v-4C7.3 4.1 9.4 2 12 2z"/></svg>
      </a>
      <a class="am-menu__icon" href="#" aria-label="TikTok">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M16.5 3c.4 2.6 2 4.2 4.5 4.5v3.2c-1.7.1-3.2-.4-4.5-1.4v6.2c0 3.6-2.8 6.5-6.4 6.5S3.6 19.1 3.6 15.5 6.5 9 10.1 9c.5 0 1 .1 1.4.2v3.4c-.4-.2-.8-.3-1.4-.3-1.7 0-3.1 1.4-3.1 3.2s1.4 3.2 3.1 3.2 3.1-1.4 3.1-3.2V3h3.3z"/></svg>
      </a>
    </div>

    {%- comment -%} Footer menu (handle: footer) {%- endcomment -%}
    {%- assign footer_menu = linklists['footer'] -%}
    {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
      <div class="am-menu__footer">
        <ul class="am-menu__footer-list" role="list">
          {%- for l in footer_menu.links -%}
            <li class="am-menu__footer-item">
              <a class="am-menu__footer-link" href="{{ l.url }}">{{ l.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
