{% comment %}
  -----------------------------------------------------------------------------
  FASHION CART DRAWER
  Features: Ajax API, Free Shipping Bar, Backdrop Blur, Slide-in Animation
  -----------------------------------------------------------------------------
{% endcomment %}

{% assign free_shipping_goal = 30000 %} <section id="fashion-cart-drawer">
  <div id="cart-overlay" class="cart-overlay" onclick="closeCartDrawer()"></div>

  <div id="cart-container" class="cart-container">
    
    <header class="drawer-header">
      <div class="header-top">
        <h3>SUA SACOLA <span class="count-bubble">({{ cart.item_count }})</span></h3>
        <button class="close-btn" onclick="closeCartDrawer()" aria-label="Fechar carrinho">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="shipping-bar-wrapper">
        <p id="shipping-message" class="shipping-msg">Calculando benefícios...</p>
        <div class="progress-bg">
          <div id="shipping-progress" class="progress-fill"></div>
        </div>
      </div>
    </header>

    <div id="drawer-items" class="drawer-items">
      <div class="loading-spinner"></div>
    </div>

    <footer id="drawer-footer" class="drawer-footer {% if cart.item_count == 0 %}hidden{% endif %}">
      <div class="subtotal-row">
        <span>SUBTOTAL</span>
        <span id="cart-total-price">{{ cart.total_price | money }}</span>
      </div>
      <p class="tax-disclaimer">Taxas e frete calculados no checkout.</p>
      
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="checkout-btn">
          FINALIZAR COMPRA
        </button>
      </form>
    </footer>

  </div>
</section>

<style>
  :root {
    --drawer-z-index: 9999;
    --drawer-width: 420px;
    --drawer-bg: #FFFFFF;
    --drawer-text: #111111;
    --drawer-accent: #000000; /* Preto Profundo */
    --drawer-border: #E5E5E5;
    --drawer-gray: #757575;
    --success-color: #2e8b57; /* Verde suave para sucesso */
  }

  /* Overlay */
  .cart-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px); /* Toque Premium */
    z-index: calc(var(--drawer-z-index) - 1);
    opacity: 0; visibility: hidden;
    transition: all 0.4s ease;
  }
  .cart-overlay.is-open { opacity: 1; visibility: visible; }

  /* Container Principal */
  .cart-container {
    position: fixed; top: 0; right: 0; height: 100%; width: 100%; max-width: var(--drawer-width);
    background: var(--drawer-bg);
    z-index: var(--drawer-z-index);
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); /* Animação suave "Apple Style" */
    display: flex; flex-direction: column;
    box-shadow: -10px 0 30px rgba(0,0,0,0.05);
  }
  .cart-container.is-open { transform: translateX(0); }

  /* Header */
  .drawer-header { padding: 25px 30px 15px; border-bottom: 1px solid transparent; }
  .header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .header-top h3 { margin: 0; font-size: 16px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; }
  .close-btn { background: none; border: none; cursor: pointer; padding: 5px; transition: transform 0.2s; }
  .close-btn:hover { transform: scale(1.1); }

  /* Barra de Frete */
  .shipping-bar-wrapper { margin-top: 10px; }
  .shipping-msg { font-size: 13px; text-align: center; margin-bottom: 8px; font-weight: 500; }
  .progress-bg { height: 4px; background: #F0F0F0; width: 100%; border-radius: 2px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--drawer-accent); width: 0%; transition: width 0.6s ease; }

  /* Lista de Itens */
  .drawer-items { flex: 1; overflow-y: auto; padding: 20px 30px; }
  
  /* Item Individual */
  .cart-item { display: flex; gap: 15px; margin-bottom: 25px; padding-bottom: 25px; border-bottom: 1px solid var(--drawer-border); animation: fadeIn 0.3s ease; }
  .item-img { width: 85px; height: 110px; object-fit: cover; border-radius: 2px; background: #f9f9f9; }
  .item-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .item-name { font-size: 14px; font-weight: 500; text-transform: uppercase; margin-bottom: 4px; display: block; text-decoration: none; color: inherit; }
  .item-variant { font-size: 12px; color: var(--drawer-gray); margin-bottom: 8px; }
  
  /* Controles (Qtd e Preço) */
  .item-actions { display: flex; justify-content: space-between; align-items: center; }
  .qty-selector { display: flex; border: 1px solid var(--drawer-border); height: 32px; width: 90px; }
  .qty-btn { width: 30px; background: none; border: none; cursor: pointer; font-size: 14px; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
  .qty-btn:hover { background: #f5f5f5; }
  .qty-input { width: 30px; border: none; text-align: center; font-size: 12px; font-weight: 600; padding: 0; -moz-appearance: textfield; }
  .item-price { font-size: 14px; font-weight: 600; }
  .remove-link { font-size: 10px; text-decoration: underline; color: var(--drawer-gray); cursor: pointer; margin-top: 5px; display: inline-block; letter-spacing: 0.5px; text-transform: uppercase; }

  /* Empty State */
  .empty-state { text-align: center; padding-top: 60px; }
  .empty-text { margin-bottom: 20px; font-size: 14px; color: var(--drawer-gray); }
  .btn-continue { display: inline-block; padding: 12px 30px; background: var(--drawer-accent); color: white; text-transform: uppercase; font-size: 12px; letter-spacing: 1px; text-decoration: none; font-weight: 600; }

  /* Footer */
  .drawer-footer { padding: 25px 30px; border-top: 1px solid var(--drawer-border); background: #fff; }
  .drawer-footer.hidden { display: none; }
  .subtotal-row { display: flex; justify-content: space-between; font-size: 14px; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 10px; }
  .tax-disclaimer { font-size: 11px; color: var(--drawer-gray); text-align: center; margin-bottom: 20px; }
  .checkout-btn { width: 100%; background: var(--drawer-accent); color: #fff; border: none; padding: 16px; text-transform: uppercase; font-size: 13px; font-weight: 600; letter-spacing: 1.5px; cursor: pointer; transition: opacity 0.3s; }
  .checkout-btn:hover { opacity: 0.9; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
  (function() {
    const shippingThreshold = {{ free_shipping_goal }}; 
    
    // Funções Globais
    window.openCartDrawer = function() {
      document.getElementById('cart-overlay').classList.add('is-open');
      document.getElementById('cart-container').classList.add('is-open');
      fetchCartData(); // Atualiza ao abrir
    };

    window.closeCartDrawer = function() {
      document.getElementById('cart-overlay').classList.remove('is-open');
      document.getElementById('cart-container').classList.remove('is-open');
    };

    window.updateItemQty = function(key, qty) {
      const data = { id: key, quantity: qty };
      fetch(window.Shopify.routes.root + 'cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
      .then(response => response.json())
      .then(cart => {
        renderCart(cart);
        updateCartCount(cart.item_count);
      })
      .catch(console.error);
    };

    // Helper: Formata Dinheiro (Simples - adapta para BRL)
    function formatMoney(cents) {
      return (cents / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    // Helper: Atualiza Contadores do Tema
    function updateCartCount(count) {
      // Atualiza badge interna
      const drawerCount = document.querySelector('.count-bubble');
      if(drawerCount) drawerCount.innerText = `(${count})`;
      
      // Tenta atualizar badges do tema (seletores comuns)
      const themeBadges = document.querySelectorAll('.cart-count, #CartCount, [data-cart-count]');
      themeBadges.forEach(el => el.innerText = count);
    }

    // Renderiza HTML dos Produtos
    function renderCart(cart) {
      const container = document.getElementById('drawer-items');
      const footer = document.getElementById('drawer-footer');
      
      // Atualiza Subtotal
      document.getElementById('cart-total-price').innerText = formatMoney(cart.total_price);
      
      // Atualiza Barra de Frete
      updateShippingBar(cart.total_price);

      if (cart.item_count === 0) {
        footer.classList.add('hidden');
        container.innerHTML = `
          <div class="empty-state">
            <p class="empty-text">Sua sacola está vazia.</p>
            <a href="#" onclick="event.preventDefault(); closeCartDrawer();" class="btn-continue">Ver Novidades</a>
          </div>`;
      } else {
        footer.classList.remove('hidden');
        let html = '';
        cart.items.forEach(item => {
          html += `
          <div class="cart-item">
            <img src="${item.featured_image.url}" class="item-img" alt="${item.title}">
            <div class="item-info">
              <div>
                <a href="${item.url}" class="item-name">${item.product_title}</a>
                <div class="item-variant">${item.variant_title || ''}</div>
              </div>
              <div class="item-actions">
                <div class="qty-selector">
                  <button type="button" class="qty-btn" onclick="updateItemQty('${item.key}', ${item.quantity - 1})">−</button>
                  <input type="text" class="qty-input" value="${item.quantity}" readonly>
                  <button type="button" class="qty-btn" onclick="updateItemQty('${item.key}', ${item.quantity + 1})">+</button>
                </div>
                <span class="item-price">${formatMoney(item.final_line_price)}</span>
              </div>
              <div class="remove-link" onclick="updateItemQty('${item.key}', 0)">Remover</div>
            </div>
          </div>`;
        });
        container.innerHTML = html;
      }
    }

    // Lógica da Barra de Frete
    function updateShippingBar(total) {
      const msg = document.getElementById('shipping-message');
      const bar = document.getElementById('shipping-progress');
      
      if (total >= shippingThreshold) {
        msg.innerHTML = "🎉 Parabéns! <strong>Frete Grátis</strong> aprovado!";
        bar.style.width = '100%';
        bar.style.backgroundColor = 'var(--success-color)';
      } else {
        const missing = shippingThreshold - total;
        const pct = (total / shippingThreshold) * 100;
        msg.innerHTML = `Faltam <strong>${formatMoney(missing)}</strong> para Frete Grátis`;
        bar.style.width = pct + '%';
        bar.style.backgroundColor = 'var(--drawer-accent)';
      }
    }

    // Fetch Inicial
    function fetchCartData() {
      fetch(window.Shopify.routes.root + 'cart.js')
        .then(res => res.json())
        .then(cart => {
          renderCart(cart);
          updateCartCount(cart.item_count);
        });
    }

    // Inicializa ao carregar (opcional, para pré-carregar dados)
    // fetchCartData(); 

  })();
</script>