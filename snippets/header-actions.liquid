<div class="am-header-actions" role="navigation" aria-label="Ações">
  <div class="am-actions">
    <!-- Busca inline (mantida) -->
   

    <!-- CONTA (popover no desktop + drawer no mobile) -->
    {% if shop.customer_accounts_enabled %}
      <!-- Desktop: popover ancorado no botão -->
<anchored-popover-component data-close-on-resize="true" class="account-popover">
        <button
          type="button"
          class="am-icon-btn am-account-trigger"
          aria-label="Conta"
          aria-haspopup="dialog"
          popovertarget="account-popover"
          popovertargetaction="toggle"
          ref="trigger"
        >
          <span class="svg-wrapper" aria-hidden="true">
            {{ 'icon-account.svg' | inline_asset_content }}
          </span>
        </button>

        <div
          class="account-popover__panel details-content color-{{ settings.popover_color_scheme }}"
          id="account-popover"
          popover="auto"
          ref="popover"
        >
          {% render 'account-actions' %}
        </div>
      </anchored-popover-component>

      
    {% endif %}

 <!-- CARRINHO (Premium: Popover no desktop / Drawer no mobile) -->
<script type="module" src="{{ 'cart-icon.js' | asset_url }}" fetchpriority="low"></script>
<style>
  /* Força a fonte da bolinha do carrinho */
  .am-cart-icon .cart-bubble,
  .am-cart-icon .cart-bubble__text,
  .am-cart-icon .cart-bubble__text span[aria-hidden="true"] { 
    font-family: 'SoraCustom', sans-serif !important;
    font-weight: 700;
    font-size: 10px; /* Ajuste para caber bem na bolinha */
    line-height: normal; /* Centraliza verticalmente */
  }
  
  /* Ajuste do tamanho da bolinha */
  .am-cart-icon .cart-bubble {
    width: 18px;
    height: 18px;
    min-width: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

{% capture cart_icon %}
  <cart-icon class="am-cart-icon" data-testid="cart-icon">
    <span class="svg-wrapper" aria-hidden="true">
      {{ 'icon-cart.svg' | inline_asset_content }}
    </span>
    {% render 'cart-bubble', limit: 99, live_region: true %}
  </cart-icon>
{% endcapture %}

<!-- CARRINHO (Side Cart Drawer) -->
  <button
    type="button"
    class="am-icon-btn am-cart-btn"
    aria-label="{{ 'accessibility.cart' | t }}"
    aria-haspopup="dialog"
    data-cart-drawer-open
  >
    {{ cart_icon }}
  </button>
</div>
</div>
