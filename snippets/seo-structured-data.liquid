{% doc %}
Renders entity, editorial, Product and BreadcrumbList structured data.
{% enddoc %}

{%- liquid
  assign organization_logo = blank
  if settings.logo != blank
    assign organization_logo = settings.logo | image_url: width: 600
    unless organization_logo contains 'http'
      assign organization_logo = organization_logo | prepend: 'https:'
    endunless
  endif
-%}

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ request.origin | append: '/#organization' | json }},
      "name": "A MARCA",
      "legalName": "A MARCA LTDA.",
      "url": {{ request.origin | json }},
      "taxID": "63.017.072/0001-61",
      {%- if organization_logo != blank -%}
        "logo": { "@type": "ImageObject", "url": {{ organization_logo | json }} },
      {%- endif -%}
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Petrolina",
        "addressRegion": "Pernambuco",
        "addressCountry": "BR"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "url": {{ request.origin | append: '/pages/contato' | json }},
        "availableLanguage": "pt-BR"
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'page' and page.handle == 'a-marca' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "@id": {{ canonical_url | append: '#about' | json }},
      "url": {{ canonical_url | json }},
      "name": "A MARCA",
      "about": {
        "@type": "Organization",
        "@id": {{ request.origin | append: '/#organization' | json }},
        "name": "A MARCA",
        "legalName": "A MARCA LTDA.",
        "url": {{ request.origin | json }},
        "taxID": "63.017.072/0001-61"
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'page' and page.handle == 'contato' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "@id": {{ canonical_url | append: '#contact' | json }},
      "url": {{ canonical_url | json }},
      "name": "Contato | A MARCA",
      "about": { "@id": {{ request.origin | append: '/#organization' | json }} }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'article' and article != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ article.title | json }},
      "url": {{ canonical_url | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} },
      "author": { "@type": "Organization", "name": {{ article.author | json }}, "url": {{ request.origin | json }} },
      "publisher": {
        "@type": "Organization",
        "@id": {{ request.origin | append: '/#organization' | json }},
        "name": "A MARCA"{%- if organization_logo != blank -%},
        "logo": { "@type": "ImageObject", "url": {{ organization_logo | json }} }{%- endif -%}
      }{%- if article.image != blank -%},
      "image": {{ article.image | image_url: width: 1600 | prepend: 'https:' | json }}{%- endif -%}
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "A MARCA", "item": {{ request.origin | json }} },
        { "@type": "ListItem", "position": 2, "name": "Fé & Propósito", "item": {{ request.origin | append: '/blogs/fe-e-proposito' | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == "product" and product != blank -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  {%- liquid
    assign seo_collection = collection
    if seo_collection == blank
      assign seo_collection = product.collections.first
    endif
    assign product_position = 2
    if seo_collection != blank
      assign product_position = 3
    endif
  -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": {{ request.origin | append: routes.root_url | json }}
        },
        {%- if seo_collection != blank -%}
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ seo_collection.title | json }},
            "item": {{ request.origin | append: seo_collection.url | json }}
          },
        {%- endif -%}
        {
          "@type": "ListItem",
          "position": {{ product_position }},
          "name": {{ product.title | json }},
          "item": {{ canonical_url | json }}
        }
      ]
    }
  </script>
{%- endif -%}
