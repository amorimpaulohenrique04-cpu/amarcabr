{%- style -%}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} .ns-fullbleed-banner {
    position: relative;
    width: 100vw;
    max-width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    background: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} .ns-fullbleed-banner__link,
  #shopify-section-{{ section.id }} .ns-fullbleed-banner__media,
  #shopify-section-{{ section.id }} .ns-fullbleed-banner__picture {
    display: block;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .ns-fullbleed-banner__image {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
    border: 0;
  }

  #shopify-section-{{ section.id }} .ns-fullbleed-banner__placeholder {
    min-height: 220px;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
    text-align: center;
    color: rgba(0,0,0,0.6);
    background: rgba(0,0,0,0.04);
  }
{%- endstyle -%}

<section>
  <div class="ns-fullbleed-banner">
    {%- if section.settings.link != blank -%}
      <a class="ns-fullbleed-banner__link" href="{{ section.settings.link }}" aria-label="{{ section.settings.alt_text | default: shop.name | escape }}">
    {%- endif -%}

    <div class="ns-fullbleed-banner__media">
      {%- if section.settings.desktop_image != blank or section.settings.mobile_image != blank -%}
        <picture class="ns-fullbleed-banner__picture">
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 375 }} 375w, {{ section.settings.mobile_image | image_url: width: 550 }} 550w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 900 }} 900w, {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w"
              sizes="100vw"
            >
          {%- endif -%}

          {%- assign fallback_image = section.settings.desktop_image -%}
          {%- if fallback_image == blank -%}
            {%- assign fallback_image = section.settings.mobile_image -%}
          {%- endif -%}

          {%- if fallback_image != blank -%}
            {{ fallback_image | image_url: width: 2400 | image_tag:
              class: 'ns-fullbleed-banner__image',
              widths: '375, 550, 750, 900, 1200, 1500, 1800, 2200, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              decoding: 'async',
              alt: section.settings.alt_text | default: shop.name
            }}
          {%- endif -%}
        </picture>
      {%- else -%}
        <div class="ns-fullbleed-banner__placeholder">
          <p>Adicione a imagem desktop e a imagem mobile no editor do tema.</p>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.link != blank -%}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Banner full largura",
  "tag": "section",
  "class": "section section-ns-fullbleed-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Imagem desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem mobile"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo",
      "default": "Nação Santa edição limitada"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link opcional"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de fundo",
      "default": "#F7F1E3"
    }
  ],
  "presets": [
    {
      "name": "Banner full largura"
    }
  ]
}
{% endschema %}