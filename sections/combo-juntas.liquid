{% comment %}
  Combo Família - Edition: High Fashion / Editorial (6-8 Pieces)
  - Alinhado ao container do site
  - Suporte para 6, 7 e 8 unidades
  - Scroll vertical na seleção de tamanhos para manter o design limpo
{% endcomment %}

<section
  class="lx-premium-builder"
  style="
    --lx-bg: {{ section.settings.page_bg }};
    --lx-text: {{ section.settings.text_color }};
    --lx-border: #E5E5E5;
    --lx-accent: #000000;
    --lx-container-width: var(--am-header-max, 1240px);
    --lx-container-padding: var(--am-header-x, 16px);
  "
>
  <div class="lx-container">
    {%- assign current_variant = product.selected_or_first_available_variant -%}

    {%- capture allowed_models_json -%}
      [
        {%- if product.metafields.custom.combo_products != blank -%}
          {%- for p in product.metafields.custom.combo_products.value -%}
            {%- if p != blank -%}
              {%- if forloop.first == false -%},{%- endif -%}
              {
                "id": {{ p.id | json }},
                "handle": {{ p.handle | json }},
                "title": {{ p.title | json }},
                "featured_image": {{ p.featured_image | image_url: width: 1200 | json }}
              }
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign first_written = true -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'combo_product' and block.settings.product != blank -%}
              {%- assign p = block.settings.product -%}
              {%- if first_written == false -%},{%- endif -%}
              {%- assign first_written = false -%}
              {
                "id": {{ p.id | json }},
                "handle": {{ p.handle | json }},
                "title": {{ p.title | json }},
                "featured_image": {{ p.featured_image | image_url: width: 1200 | json }}
              }
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      ]
    {%- endcapture -%}

    {%- capture combo_variants_json -%}
      [
        {%- for v in product.variants -%}
          {%- if forloop.first == false -%},{%- endif -%}
          {
            "id": {{ v.id | json }},
            "title": {{ v.title | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price | json }},
            "price_formatted": {{ v.price | money | json }}
          }
        {%- endfor -%}
      ]
    {%- endcapture -%}

    <div
      class="lx-builder-grid"
      data-models="{{ allowed_models_json | strip_newlines | escape }}"
      data-combo-variants="{{ combo_variants_json | strip_newlines | escape }}"
      data-size-options="{{ section.settings.size_options | escape }}"
      data-variant-6="{{ section.settings.combo_variant_6_id | strip | escape }}"
      data-variant-7="{{ section.settings.combo_variant_7_id | strip | escape }}"
      data-variant-8="{{ section.settings.combo_variant_8_id | strip | escape }}"
    >
      
      <div class="lx-panel-preview">
        <div class="lx-image-wrapper">
          <img 
            src="{{ product.featured_image | image_url: width: 1400 }}" 
            class="lx-preview-image" 
            data-main-preview
            alt="{{ product.title }}"
          >
          
          <div class="lx-floating-meta">
             <span class="lx-meta-tag">Collection</span>
             <h3 class="lx-meta-title">{{ section.settings.combo_title }}</h3>
          </div>
        </div>
      </div>

      <div class="lx-panel-interaction">
        <div class="lx-interaction-header">
            <div class="lx-step-indicator">
                <span class="lx-step-label">Passo</span>
                <div class="lx-step-numbers">
                    <span class="lx-current-step">01</span>
                    <span class="lx-separator"></span>
                    <span class="lx-total-steps">03</span>
                </div>
            </div>
            <div class="lx-progress-track">
                <div class="lx-progress-fill" style="width: 33.33%"></div>
            </div>
        </div>

        <div class="lx-steps-viewport">
          
          <div class="lx-step-content active" data-step="1">
            <h2 class="lx-step-title">Quantidade<br>do Combo</h2>
            <p class="lx-step-desc">{{ section.settings.step1_hint }}</p>
            
            <div class="lx-qty-grid">
              <button type="button" class="lx-option-card" data-qty="6">
                <span class="lx-opt-num">06</span>
                <span class="lx-opt-label">Peças</span>
              </button>
              <button type="button" class="lx-option-card" data-qty="7">
                <span class="lx-opt-num">07</span>
                <span class="lx-opt-label">Peças</span>
              </button>
              <button type="button" class="lx-option-card" data-qty="8">
                <span class="lx-opt-num">08</span>
                <span class="lx-opt-label">Peças</span>
              </button>
            </div>
          </div>

          <div class="lx-step-content" data-step="2">
            <h2 class="lx-step-title">Selecione<br>o Modelo</h2>
            <p class="lx-step-desc">{{ section.settings.model_hint }}</p>
            
            <div class="lx-model-selector-wrapper">
              <div class="lx-csel lx-csel--model" data-csel="model">
                <button type="button" class="lx-csel-trigger" data-trigger>
                  <span class="lx-csel-label" data-selected-label>{{ section.settings.model_placeholder }}</span>
                  <svg class="lx-csel-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="lx-csel-dropdown">
                  <ul class="lx-csel-list" data-list></ul>
                </div>
              </div>
            </div>
          </div>

          <div class="lx-step-content" data-step="3">
            <h2 class="lx-step-title">Defina<br>os Tamanhos</h2>
            <p class="lx-step-desc">{{ section.settings.sizes_hint }}</p>
            
            <div class="lx-sizes-container-scroll">
                <div class="lx-sizes-table" data-sizes-container></div>
            </div>
          </div>

        </div>

        <div class="lx-panel-footer">
          <div class="lx-footer-info">
             <span class="lx-price-label">Total estimado</span>
             <div class="lx-main-price" data-total-price>{{ current_variant.price | money }}</div>
          </div>
          
          <div class="lx-footer-actions">
            <button type="button" class="lx-nav-back" onclick="window.history.back()">Voltar</button>
            
            <div class="lx-control-group">
                <button type="button" class="lx-circle-btn" data-prev-btn disabled aria-label="Anterior">←</button>
                <button type="button" class="lx-text-btn" data-next-btn disabled>
                    <span class="lx-btn-text">Próximo</span>
                </button>
            </div>
          </div>
        </div>

        <form method="post" action="/cart/add" data-atc-form style="display:none;">
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[_combo_qty]" value="" data-prop="qty">
          <input type="hidden" name="properties[_combo_model]" value="" data-prop="model">
          <input type="hidden" name="properties[_combo_sizes]" value="" data-prop="sizes">
        </form>
      </div>
    </div>
  </div><noscript></noscript>
  <style>
    .lx-premium-builder {
      --font-primary: 'Inter', sans-serif;
      --easing: cubic-bezier(0.19, 1, 0.22, 1);
      background: var(--lx-bg);
      font-family: var(--font-primary);
      color: var(--lx-text);
      padding: 60px 20px; 
      width: 100%;
    }

    /* Container alinhado ao header em todos os dispositivos */
    .lx-container {
      width: 100%;
      max-width: var(--lx-container-width);
      margin: 0 auto;
      padding-inline: var(--lx-container-padding);
      box-sizing: border-box;
    }

    .lx-builder-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      align-items: start;
    }

    @media (min-width: 1024px) {
      .lx-builder-grid {
        grid-template-columns: 1fr 480px; 
        gap: 60px;
      }
    }
    
    @media (min-width: 1400px) {
        .lx-builder-grid {
        grid-template-columns: 1fr 550px;
        gap: 80px;
      }
    }

    /* === PREVIEW PANEL === */
    .lx-image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 3 / 4; 
        background: #f4f4f4;
        overflow: hidden;
    }

    .lx-preview-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
      transition: opacity 0.8s var(--easing);
    }
    
    .lx-floating-meta {
        position: absolute;
        bottom: 30px;
        left: 30px;
        z-index: 10;
        pointer-events: none;
    }
    
    .lx-meta-tag {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        display: block;
        margin-bottom: 6px;
        color: #fff;
        text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    }
    
    .lx-meta-title {
        font-size: 20px;
        font-weight: 400;
        margin: 0;
        letter-spacing: -0.02em;
        color: #fff;
        text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    }

    /* === INTERACTION PANEL === */
    .lx-panel-interaction {
      display: flex;
      flex-direction: column;
      background: #fff;
      position: relative;
      justify-content: space-between;
      min-height: 600px;
      height: 100%;
    }
    
    .lx-interaction-header { margin-bottom: 40px; }

    .lx-step-indicator {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 16px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #000;
    }
    
    .lx-step-numbers { font-variant-numeric: tabular-nums; }
    
    .lx-separator {
        display: inline-block;
        width: 30px;
        height: 1px;
        background: currentColor;
        vertical-align: middle;
        margin: 0 8px;
        opacity: 0.2;
    }

    .lx-progress-track { height: 1px; width: 100%; background: #eee; position: relative; }
    .lx-progress-fill { height: 1px; background: #000; position: absolute; left: 0; top: 0; transition: width 0.8s var(--easing); }

    .lx-steps-viewport { flex: 1; position: relative; }

    .lx-step-content {
      position: absolute;
      top: 0; left: 0; width: 100%;
      opacity: 0; visibility: hidden;
      transform: translateY(10px);
      transition: all 0.6s var(--easing);
    }

    .lx-step-content.active { opacity: 1; visibility: visible; transform: translateY(0); position: relative; }
    .lx-step-content.exit { transform: translateY(-10px); opacity: 0; }

    .lx-step-title { font-size: 32px; font-weight: 400; line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 10px 0; color: #000; }
    .lx-step-desc { font-size: 13px; color: #666; margin-bottom: 30px; line-height: 1.5; max-width: 320px; }

    /* UI Components */
    .lx-qty-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    
    .lx-option-card {
        background: transparent; border: 1px solid #ddd; padding: 24px 10px;
        text-align: center; cursor: pointer; transition: all 0.3s ease;
        display: flex; flex-direction: column; align-items: center; gap: 4px; border-radius: 0; 
    }
    .lx-option-card:hover { border-color: #000; }
    .lx-option-card.selected { background: #000; border-color: #000; color: #fff; }
    .lx-opt-num { font-size: 20px; font-weight: 500; }
    .lx-opt-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.7; }

    /* Seletor elegante (custom dropdown) - substitui select nativo */
    .lx-csel--model { position: relative; width: 100%; z-index: 2; }
    .lx-csel--model .lx-csel-trigger {
      width: 100%; display: flex; align-items: center; justify-content: space-between;
      background: transparent; border: none; border-bottom: 1px solid #000;
      padding: 15px 0; font-family: var(--font-primary); font-size: 18px; letter-spacing: -0.02em;
      color: #000; cursor: pointer; text-align: left; transition: opacity 0.3s;
    }
    .lx-csel--model .lx-csel-trigger:hover { opacity: 0.7; }
    .lx-csel--model .lx-csel-label { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 8px; }
    .lx-csel--model .lx-csel-chevron { flex-shrink: 0; color: #000; transition: transform 0.2s ease; }
    .lx-csel--model.is-open .lx-csel-chevron { transform: rotate(180deg); }
    .lx-csel--model .lx-csel-dropdown {
      position: absolute; top: calc(100% + 8px); left: 0; right: 0;
      background: #fff; border: 1px solid #eee; border-radius: 0;
      box-shadow: 0 12px 24px rgba(0,0,0,0.08); z-index: 100;
      opacity: 0; visibility: hidden; transform: translateY(-8px);
      transition: all 0.2s cubic-bezier(0.19, 1, 0.22, 1);
      overflow: hidden; pointer-events: none;
      max-height: min(280px, 50vh);
    }
    .lx-csel--model.is-open .lx-csel-dropdown { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; }
    .lx-csel--model .lx-csel-list { list-style: none; margin: 0; padding: 0; max-height: 260px; overflow-y: auto; -webkit-overflow-scrolling: touch; }
    .lx-csel--model .lx-csel-opt {
      display: flex; align-items: center; gap: 12px;
      padding: 14px 16px; font-size: 16px; color: #000;
      cursor: pointer; transition: background 0.15s; border-bottom: 1px solid #f5f5f5;
    }
    .lx-csel--model .lx-csel-opt:last-child { border-bottom: none; }
    .lx-csel--model .lx-csel-opt:hover { background: #f7f7f7; }
    .lx-csel--model .lx-csel-opt.is-selected { background: #f0f0f0; font-weight: 500; }
    .lx-csel--model .lx-csel-optImg { width: 40px; height: 40px; border-radius: 4px; object-fit: cover; flex-shrink: 0; }

    /* NOVO: Scroll Area para Sizes (Importante para 8 itens) */
    .lx-sizes-container-scroll {
        max-height: 380px; /* Altura máxima antes de rolar */
        overflow-y: auto;
        padding-right: 5px; /* Espaço para scrollbar */
    }
    
    /* Scrollbar Estilizada Minimalista */
    .lx-sizes-container-scroll::-webkit-scrollbar { width: 3px; }
    .lx-sizes-container-scroll::-webkit-scrollbar-track { background: transparent; }
    .lx-sizes-container-scroll::-webkit-scrollbar-thumb { background: #000; }

    .lx-sizes-table { display: flex; flex-direction: column; border-top: 1px solid #eee; }
    .lx-size-row { display: grid; grid-template-columns: 100px 1fr; align-items: center; padding: 16px 0; border-bottom: 1px solid #eee; }
    .lx-size-row span { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #999; }
    .lx-size-row select { width: 100%; border: none; background: transparent; text-align: right; font-size: 16px; color: #000; outline: none; cursor: pointer; font-family: var(--font-primary); }

    .lx-panel-footer { margin-top: 60px; }
    .lx-footer-info { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid #eee; }
    .lx-price-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #999; }
    .lx-main-price { font-size: 20px; font-weight: 500; }
    
    .lx-footer-actions { display: flex; justify-content: space-between; align-items: center; }
    .lx-nav-back { background: none; border: none; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; padding: 10px 0; border-bottom: 1px solid transparent; transition: border 0.3s; }
    .lx-nav-back:hover { border-bottom-color: #000; }
    
    .lx-control-group { display: flex; align-items: center; gap: 16px; }
    .lx-circle-btn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid #eee; background: #fff; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; }
    .lx-circle-btn:not(:disabled):hover { border-color: #000; }
    .lx-circle-btn:disabled { opacity: 0.3; cursor: not-allowed; }
    
    .lx-text-btn { background: #000; color: #fff; border: none; height: 44px; padding: 0 32px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; cursor: pointer; transition: transform 0.2s ease, background 0.2s; }
    .lx-text-btn:not(:disabled):hover { transform: translateY(-2px); background: #333; }
    .lx-text-btn:disabled { background: #eee; color: #999; cursor: not-allowed; }

    @media (max-width: 1023px) {
        .lx-premium-builder { padding: 40px 20px; }
        .lx-builder-grid { gap: 40px; }
        .lx-step-title { font-size: 26px; }
        .lx-image-wrapper { aspect-ratio: 3/4; }
    }
  </style>

  <script type="module">
(function(){
      const root = document.querySelector('.lx-premium-builder');
      const grid = root.querySelector('.lx-builder-grid');
      
      const models = JSON.parse(grid.getAttribute('data-models') || '[]');
      const variants = JSON.parse(grid.getAttribute('data-combo-variants') || '[]');
      const sizeOptions = (grid.getAttribute('data-size-options') || 'PP,P,M,G,GG').split(',').map(s => s.trim());
      
      // Mapeamento atualizado para 6, 7 e 8
      const variantIds = {
        '6': grid.getAttribute('data-variant-6'),
        '7': grid.getAttribute('data-variant-7'),
        '8': grid.getAttribute('data-variant-8')
      };

      let state = { step: 1, qty: null, model: null, sizes: {} };

      const panes = root.querySelectorAll('.lx-step-content');
      const qtyBtns = root.querySelectorAll('[data-qty]');
      const modelCsel = root.querySelector('[data-csel="model"]');
      const modelLabel = modelCsel ? modelCsel.querySelector('[data-selected-label]') : null;
      const sizesContainer = root.querySelector('[data-sizes-container]');
      const prevBtn = root.querySelector('[data-prev-btn]');
      const nextBtn = root.querySelector('[data-next-btn]');
      const btnText = nextBtn.querySelector('.lx-btn-text');
      const progressBar = root.querySelector('.lx-progress-fill');
      const stepNum = root.querySelector('.lx-current-step');
      const priceDisplay = root.querySelector('[data-total-price]');
      const mainPreview = root.querySelector('[data-main-preview]');
      const atcForm = root.querySelector('[data-atc-form]');

      // Popular seletor elegante de modelos (sem select nativo)
      if (modelCsel) {
        const list = modelCsel.querySelector('[data-list]');
        const trigger = modelCsel.querySelector('[data-trigger]');
        function closeModelDropdown() { modelCsel.classList.remove('is-open'); }
        models.forEach(m => {
          const li = document.createElement('li');
          li.className = 'lx-csel-opt';
          li.innerHTML = (m.featured_image ? `<img src="${m.featured_image}" alt="" class="lx-csel-optImg" loading="lazy">` : '') + `<span>${m.title}</span>`;
          li.addEventListener('click', (e) => {
            e.stopPropagation();
            list.querySelectorAll('.lx-csel-opt').forEach(o => o.classList.remove('is-selected'));
            li.classList.add('is-selected');
            state.model = String(m.id);
            if (modelLabel) modelLabel.textContent = m.title;
            closeModelDropdown();
            updateUI();
          });
          list.appendChild(li);
        });
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          modelCsel.classList.toggle('is-open');
        });
        document.addEventListener('click', (e) => { if (!e.target.closest('.lx-csel--model')) closeModelDropdown(); });
      }

      function updateUI() {
        panes.forEach(p => {
          const s = parseInt(p.dataset.step);
          p.classList.remove('active', 'exit');
          if (s === state.step) p.classList.add('active');
          else if (s < state.step) p.classList.add('exit');
        });

        const percent = (state.step / 3) * 100;
        progressBar.style.width = percent + '%';
        stepNum.textContent = '0' + state.step;
        prevBtn.disabled = state.step === 1;
        
        let canNext = false;
        if (state.step === 1 && state.qty) canNext = true;
        if (state.step === 2 && state.model) canNext = true;
        if (state.step === 3) {
          const count = Object.values(state.sizes).filter(Boolean).length;
          if (count === state.qty) canNext = true;
        }

        nextBtn.disabled = !canNext;
        btnText.textContent = state.step === 3 ? 'ADICIONAR' : 'PRÓXIMO';

        const vid = variantIds[state.qty];
        const vObj = variants.find(v => String(v.id) === String(vid));
        if (vObj) priceDisplay.textContent = vObj.price_formatted;

        if (state.model) {
          const mObj = models.find(m => String(m.id) === String(state.model));
          if (mObj && mObj.featured_image && mainPreview.src !== mObj.featured_image) {
            mainPreview.style.opacity = '0';
            setTimeout(() => {
              mainPreview.src = mObj.featured_image;
              mainPreview.style.opacity = '1';
            }, 300);
          }
        }
      }

      function goToStep(s) {
        if (s < 1 || s > 3) return;
        state.step = s;
        updateUI();
      }

      qtyBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          state.qty = parseInt(btn.dataset.qty);
          qtyBtns.forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          renderSizes();
          setTimeout(() => goToStep(2), 300);
        });
      });

      // state.model é definido ao clicar em uma opção do seletor elegante

      function renderSizes() {
        sizesContainer.innerHTML = '';
        state.sizes = {};
        for (let i = 1; i <= state.qty; i++) {
          const div = document.createElement('div');
          div.className = 'lx-size-row';
          div.innerHTML = `
            <span>PEÇA ${i}</span>
            <select data-idx="${i}">
              <option value="">Selecione</option>
              ${sizeOptions.map(s => `<option value="${s}">${s}</option>`).join('')}
            </select>
          `;
          sizesContainer.appendChild(div);
          div.querySelector('select').addEventListener('change', (e) => {
            state.sizes[i] = e.target.value;
            updateUI();
          });
        }
      }

      prevBtn.addEventListener('click', () => goToStep(state.step - 1));
      nextBtn.addEventListener('click', () => {
        if (state.step < 3) goToStep(state.step + 1);
        else submitBuilder();
      });

      async function submitBuilder() {
        const vid = variantIds[state.qty];
        atcForm.querySelector('[data-variant-input]').value = vid;
        atcForm.querySelector('[data-prop="qty"]').value = state.qty;
        
        const mObj = models.find(m => String(m.id) === String(state.model));
        atcForm.querySelector('[data-prop="model"]').value = mObj ? mObj.title : '';
        
        const sizesStr = Object.entries(state.sizes).map(([k, v]) => `T${k}: ${v}`).join(', ');
        atcForm.querySelector('[data-prop="sizes"]').value = sizesStr;

        nextBtn.disabled = true;
        btnText.textContent = 'ENVIANDO...';
        try {
          var sectionIds = [];
          document.querySelectorAll('cart-items-component[data-section-id]').forEach(function(el){ if(el.dataset.sectionId) sectionIds.push(el.dataset.sectionId); });
          var formData = new FormData(atcForm);
          if(sectionIds.length){ formData.set('sections', sectionIds.join(',')); formData.set('sections_url', window.location.pathname); }
          var res = await fetch('/cart/add.js', { method: 'POST', body: formData });
          var data = await res.json();
          if(!res.ok) throw new Error(data.message || 'Falha ao adicionar');
          var headerSectionId = sectionIds[0] || 'header_section';
          function dispatchCartUpdate(sectionsPayload){ var payload = { source: 'combo-juntas', itemCount: 1 }; if(sectionsPayload) payload.sections = sectionsPayload; document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail: { resource: {}, sourceId: 'combo-juntas', data: payload } })); }
          function openCartDrawer(){
  try {
    document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
    return;
  } catch (_) {}
  var btn = document.querySelector('[data-cart-drawer-open]');
  if (btn) btn.click();
}
          if(data.sections && data.sections[headerSectionId]){ dispatchCartUpdate(data.sections); openCartDrawer(); }
          else{ var sectionUrl = new URL(window.location.href); sectionUrl.searchParams.set('sections', headerSectionId); fetch(sectionUrl.toString()).then(function(r){ return r.json(); }).then(function(sectionJson){ if(sectionJson && sectionJson[headerSectionId]) dispatchCartUpdate(sectionJson); openCartDrawer(); }).catch(function(){ openCartDrawer(); }); }
          btnText.textContent = 'ADICIONADO!';
        } catch(err) {
          btnText.textContent = 'ERRO';
          alert(err.message || 'Erro ao adicionar ao carrinho.');
        }
        nextBtn.disabled = false;
        btnText.textContent = 'ADICIONAR';
      }

      updateUI();
    })();
  </script>
</section>

