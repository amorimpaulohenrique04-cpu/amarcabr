{% comment %}
  Seção: Coleções Divididas (Desktop & Mobile Separados)
  Fix: Tablet também exibe a imagem da opção Mobile (SEM mudar layout/posição)
{% endcomment %}

<section
  class="split-collections-section section-{{ section.id }}"
  style="
    padding-top: {{ section.settings.pt }}px;
    padding-bottom: {{ section.settings.pb }}px;
    margin-top: {{ section.settings.mt }}px;
    margin-bottom: {{ section.settings.mb }}px;
  "
>
  <div class="split-container">
    
    {%- for block in section.blocks -%}
      <div class="split-item reveal-observer" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.collection_link }}" class="split-link-wrapper">
          <div class="split-image-container">
            
            {% comment %} --- IMAGEM DESKTOP --- {% endcomment %}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1500 | image_tag:
                loading: 'lazy',
                widths: '550, 750, 1100, 1500',
                class: 'split-image img-desktop',
                alt: block.settings.image.alt | escape
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'split-placeholder img-desktop' }}
            {%- endif -%}

            {% comment %} --- IMAGEM MOBILE (fallback para Desktop se vazio) --- {% endcomment %}
            {% assign mobile_image = block.settings.image_mobile | default: block.settings.image %}
            
            {%- if mobile_image != blank -%}
              {{ mobile_image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750',
                class: 'split-image img-mobile',
                alt: mobile_image.alt | escape
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'split-placeholder img-mobile' }}
            {%- endif -%}

            <div class="split-overlay"></div>
          </div>
          
          <div class="split-content">
            <div class="btn-chique">
              {{ block.settings.button_label }}
            </div>
          </div>
        </a>
      </div>
    {%- endfor -%}

  </div>
</section>

<style>
  .section-{{ section.id }} .split-container {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    overflow: hidden;
  }

  .section-{{ section.id }} .split-item {
    position: relative;
    flex: 1 1 50%;
    min-width: 350px;
    height: auto;
    background: #f4f4f4;
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }} .split-item {
      flex: 1 1 100%;
      height: auto;
    }
  }

  /* --- CONTROLE DE EXIBIÇÃO DESKTOP/MOBILE --- */
  .section-{{ section.id }} .img-desktop {
    display: block;
  }
  .section-{{ section.id }} .img-mobile {
    display: none; /* Esconde mobile no desktop */
  }

  /* ✅ Tablet + Mobile: exibe a imagem mobile (SEM mexer em layout) */
  @media screen and (max-width: 1024px) {
    .section-{{ section.id }} .img-desktop {
      display: none; /* Esconde desktop no tablet e mobile */
    }
    .section-{{ section.id }} .img-mobile {
      display: block; /* Mostra mobile no tablet e mobile */
    }
    /* Tablet: evita corte da imagem */
    .section-{{ section.id }} .split-item {
      height: auto;
    }
    .section-{{ section.id }} .split-image {
      height: auto;
      object-fit: contain;
    }
  }

  /* --- ANIMAÇÃO --- */
  .section-{{ section.id }} .split-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    transition: opacity 1s ease;
  }

  .section-{{ section.id }} .btn-chique {
    opacity: 0;
    transform: translateY(20px);
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.3s;
  }

  /* Classe ativada via JS */
  .section-{{ section.id }} .split-item.is-visible .split-image {
    opacity: 1;
  }

  .section-{{ section.id }} .split-item.is-visible .btn-chique {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- ELEMENTOS VISUAIS --- */
  .section-{{ section.id }} .split-link-wrapper {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .section-{{ section.id }} .split-overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.15);
    transition: background 0.8s ease;
    z-index: 1;
  }

  .section-{{ section.id }} .split-content {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    width: 100%;
    text-align: center;
    pointer-events: none;
  }

  .section-{{ section.id }} .btn-chique {
    display: inline-block;
    padding: 14px 40px;
    color: #ffffff;
    border: 1px solid #ffffff;
    background: rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  @media (hover: hover) {
    .section-{{ section.id }} .split-item:hover .split-image {
      opacity: 0.98;
    }
    .section-{{ section.id }} .split-item:hover .split-overlay {
      background: rgba(0, 0, 0, 0.3);
    }
    .section-{{ section.id }} .split-item:hover .btn-chique {
      background: #ffffff;
      color: #000000;
    }
  }
</style>

<script type="module">
(function() {
    const splitItems = document.querySelectorAll('.section-{{ section.id }} .reveal-observer');
    
    const observerOptions = {
      threshold: 0.2,
      rootMargin: "0px 0px -50px 0px"
    };

    const splitObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          splitObserver.unobserve(entry.target);
        }
      });
    }, observerOptions);

    splitItems.forEach(item => splitObserver.observe(item));
  })();
</script>

{% schema %}
{
  "name": "Coleções Divididas",
  "max_blocks": 2,
  "settings": [
    {
      "type": "range",
      "id": "pt",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding inferior",
      "default": 0
    },
    {
      "type": "range",
      "id": "mt",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margem superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Margem inferior",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Coleção",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem Desktop" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem Mobile (Opcional)" },
        { "type": "text", "id": "button_label", "label": "Botão", "default": "VER COLEÇÃO" },
        { "type": "url", "id": "collection_link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coleções Divididas",
      "blocks": [ { "type": "collection" }, { "type": "collection" } ]
    }
  ]
}
{% endschema %}
