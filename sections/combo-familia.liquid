<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"></noscript>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign preview_image = section.settings.fallback_image | default: product.featured_image
-%}

{%- capture allowed_models_json -%}
  [
    {%- liquid
      if product.metafields.custom.combo_products != blank
        assign source_list = product.metafields.custom.combo_products.value
      else
        assign source_list = section.blocks | map: 'settings' | map: 'product'
      endif

      assign emitted_models = 0
    -%}

    {%- for p_adult in source_list -%}
      {%- if p_adult != blank -%}
        {%- assign p_kids = p_adult.metafields.custom.kids_product.value -%}

        {%- comment -%}
          A estampa é escolhida uma única vez pelo produto adulto.
          O produto infantil correspondente deve estar vinculado em:
          custom.kids_product
        {%- endcomment -%}

        {%- if p_kids != blank -%}
          {%- if emitted_models > 0 -%},{%- endif -%}

          {
            "id": {{ p_adult.id | json }},
            "title": {{ p_adult.title | json }},
            "adult_product_id": {{ p_adult.id | json }},
            "kids_product_id": {{ p_kids.id | json }},
            "featured_image": {%- if p_adult.featured_image != blank -%}{{ p_adult.featured_image | image_url: width: 1200 | json }}{%- else -%}null{%- endif -%},
            "variants": [
              {%- assign emitted_variants = 0 -%}

              {%- for v in p_adult.variants -%}
                {%- if emitted_variants > 0 -%},{%- endif -%}
                {
                  "id": {{ v.id | json }},
                  "available": {{ v.available | json }},
                  "options": {{ v.options | json }},
                  "type": "adult"
                }
                {%- assign emitted_variants = emitted_variants | plus: 1 -%}
              {%- endfor -%}

              {%- for v in p_kids.variants -%}
                {%- if emitted_variants > 0 -%},{%- endif -%}
                {
                  "id": {{ v.id | json }},
                  "available": {{ v.available | json }},
                  "options": {{ v.options | json }},
                  "type": "kids"
                }
                {%- assign emitted_variants = emitted_variants | plus: 1 -%}
              {%- endfor -%}
            ]
          }

          {%- assign emitted_models = emitted_models | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  ]
{%- endcapture -%}

{%- capture combo_variants_json -%}
  [
    {%- for v in product.variants -%}
      {%- unless forloop.first -%},{%- endunless -%}
      {
        "id": {{ v.id | json }},
        "title": {{ v.title | json }},
        "available": {{ v.available | json }},
        "price": {{ v.price | json }},
        "price_formatted": {{ v.price | money | json }},
        "compare_at_price": {{ v.compare_at_price | default: 0 | json }},
        "compare_at_formatted": {%- if v.compare_at_price != blank and v.compare_at_price > v.price -%}{{ v.compare_at_price | money | json }}{%- else -%}null{%- endif -%}
      }
    {%- endfor -%}
  ]
{%- endcapture -%}

<section
  id="family-combo-{{ section.id }}"
  class="family-combo"
  style="
    --fc-bg: {{ section.settings.page_bg }};
    --fc-card-bg: {{ section.settings.card_bg }};
    --fc-text: {{ section.settings.text_color }};
    --fc-muted: {{ section.settings.muted_color }};
    --fc-accent: {{ section.settings.accent_color }};
    --fc-container: var(--am-header-max, 1200px);
    --fc-gutter: var(--am-header-x, 16px);
  "
>
  <div class="family-combo__container">
    <header class="family-combo__header">
      {%- if section.settings.subtitle != blank -%}
        <p class="family-combo__eyebrow">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <h2 class="family-combo__title">{{ section.settings.title }}</h2>

      {%- if section.settings.intro != blank -%}
        <div class="family-combo__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <div
      class="family-combo__builder"
      data-models="{{ allowed_models_json | strip_newlines | escape }}"
      data-combo-variants="{{ combo_variants_json | strip_newlines | escape }}"
      data-size-order="{{ section.settings.size_options | escape }}"
      data-variant-3="{{ section.settings.combo_variant_3_id | strip | escape }}"
      data-variant-4="{{ section.settings.combo_variant_4_id | strip | escape }}"
      data-variant-5="{{ section.settings.combo_variant_5_id | strip | escape }}"
    >
      <article class="family-combo__visual-card">
        <div class="family-combo__media">
          {%- if preview_image != blank -%}
            <img
              src="{{ preview_image | image_url: width: 1400 }}"
              srcset="
                {{ preview_image | image_url: width: 700 }} 700w,
                {{ preview_image | image_url: width: 1000 }} 1000w,
                {{ preview_image | image_url: width: 1400 }} 1400w
              "
              sizes="(min-width: 990px) 55vw, 100vw"
              width="700"
              height="933"
              alt="{{ section.settings.combo_title | escape }}"
              class="family-combo__preview-image"
              data-main-preview
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'family-combo__placeholder' }}
          {%- endif -%}

          <div class="family-combo__overlay" aria-hidden="true"></div>
        </div>

        <div class="family-combo__visual-content">
          <div class="family-combo__visual-top">
            <div class="family-combo__tags">
              <span>{{ section.settings.visual_tag_1 }}</span>
              <span aria-hidden="true">/</span>
              <span>{{ section.settings.visual_tag_2 }}</span>
            </div>
          </div>

          <div class="family-combo__visual-bottom">
            <p class="family-combo__selected-model" data-preview-model>
              {{ section.settings.combo_title }}
            </p>
            <h3 class="family-combo__visual-title" data-preview-composition>
              2 Adultos + 1 Infantil
            </h3>
            <p class="family-combo__visual-note">
              Uma única estampa para todas as camisetas. Os tamanhos são escolhidos individualmente.
            </p>
          </div>
        </div>
      </article>

      <div class="family-combo__configurator">
        <div class="family-combo__progress" aria-label="Progresso da configuração">
          <div class="family-combo__progress-meta">
            <span>Passo</span>
            <span><strong data-current-step>01</strong><i aria-hidden="true"></i>03</span>
          </div>
          <div class="family-combo__progress-track" aria-hidden="true">
            <span data-progress-fill></span>
          </div>
        </div>

        <div class="family-combo__steps">
          <section class="family-combo__step is-active" data-step="1" aria-labelledby="family-combo-step-1-{{ section.id }}">
            <p class="family-combo__step-kicker">01 — Composição</p>
            <h3 id="family-combo-step-1-{{ section.id }}" class="family-combo__step-title">
              Escolha o tamanho<br>da sua família
            </h3>
            <p class="family-combo__step-description">{{ section.settings.step1_hint }}</p>

            <div class="family-combo__qty-list">
              <button type="button" class="family-combo__qty-card" data-qty="3" aria-pressed="false">
                <span class="family-combo__qty-number">03</span>
                <span class="family-combo__qty-copy">
                  <strong>Combo Essencial</strong>
                  <small>2 Adultos + 1 Infantil</small>
                  <em data-qty-price="3">Ver preço</em>
                </span>
                <span class="family-combo__qty-arrow" aria-hidden="true">→</span>
              </button>

              <button type="button" class="family-combo__qty-card" data-qty="4" aria-pressed="false">
                <span class="family-combo__qty-number">04</span>
                <span class="family-combo__qty-copy">
                  <strong>Combo Família +</strong>
                  <small>2 Adultos + 2 Infantis</small>
                  <em data-qty-price="4">Ver preço</em>
                </span>
                <span class="family-combo__qty-arrow" aria-hidden="true">→</span>
              </button>

              <button type="button" class="family-combo__qty-card" data-qty="5" aria-pressed="false">
                <span class="family-combo__qty-number">05</span>
                <span class="family-combo__qty-copy">
                  <strong>Combo Família Completa</strong>
                  <small>2 Adultos + 3 Infantis</small>
                  <em data-qty-price="5">Ver preço</em>
                </span>
                <span class="family-combo__qty-arrow" aria-hidden="true">→</span>
              </button>
            </div>
          </section>

          <section class="family-combo__step" data-step="2" aria-labelledby="family-combo-step-2-{{ section.id }}" hidden>
            <p class="family-combo__step-kicker">02 — Estampa</p>
            <h3 id="family-combo-step-2-{{ section.id }}" class="family-combo__step-title">
              Uma estampa para<br>toda a família
            </h3>
            <p class="family-combo__step-description">{{ section.settings.model_hint }}</p>

            <div class="family-combo__models" data-model-list></div>
          </section>

          <section class="family-combo__step" data-step="3" aria-labelledby="family-combo-step-3-{{ section.id }}" hidden>
            <p class="family-combo__step-kicker">03 — Tamanhos</p>
            <h3 id="family-combo-step-3-{{ section.id }}" class="family-combo__step-title">
              Escolha cada<br>tamanho
            </h3>
            <p class="family-combo__step-description">{{ section.settings.sizes_hint }}</p>

            <div class="family-combo__size-list" data-sizes-container></div>
          </section>
        </div>

        <div class="family-combo__status" data-status role="status" aria-live="polite" hidden></div>

        <footer class="family-combo__footer">
          <div class="family-combo__price-area">
            <div>
              <span class="family-combo__price-label">Valor do combo</span>
              <span class="family-combo__composition-label" data-composition-label>2 Adultos + 1 Infantil</span>
            </div>

            <div class="family-combo__prices">
              <s data-compare-price hidden></s>
              <strong data-total-price>{{ current_variant.price | money }}</strong>
            </div>
          </div>

          <div class="family-combo__actions">
            <button type="button" class="family-combo__back" data-prev disabled>
              ← Voltar
            </button>

            <button type="button" class="family-combo__next" data-next disabled>
              <span data-next-label>Próximo</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </footer>

        <form method="post" action="{{ routes.cart_add_url }}" data-atc-form hidden>
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
          <input type="hidden" name="quantity" value="1">

          <input type="hidden" name="properties[Composição]" value="" data-prop="composition">
          <input type="hidden" name="properties[Estampa]" value="" data-prop="model">
          <input type="hidden" name="properties[Tamanhos do combo]" value="" data-prop="selection">

          <input type="hidden" name="properties[_combo_qty]" value="" data-prop="qty">
          <input type="hidden" name="properties[_adult_product_id]" value="" data-prop="adult-product">
          <input type="hidden" name="properties[_kids_product_id]" value="" data-prop="kids-product">
        </form>
      </div>
    </div>
  </div>

  <style>
    #family-combo-{{ section.id }} {
      --fc-serif: 'Playfair Display', serif;
      --fc-sans: 'Montserrat', sans-serif;
      --fc-ease: cubic-bezier(.19, 1, .22, 1);
      width: 100%;
      padding: clamp(2.5rem, 5vw, 5rem) 0;
      background: var(--fc-bg);
      color: var(--fc-text);
      font-family: var(--fc-sans);
      overflow: hidden;
    }

    #family-combo-{{ section.id }} *,
    #family-combo-{{ section.id }} *::before,
    #family-combo-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #family-combo-{{ section.id }} button,
    #family-combo-{{ section.id }} select {
      font: inherit;
    }

    #family-combo-{{ section.id }} button:focus-visible,
    #family-combo-{{ section.id }} select:focus-visible {
      outline: 2px solid var(--fc-accent);
      outline-offset: 3px;
    }

    #family-combo-{{ section.id }} .family-combo__container {
      width: 100%;
      max-width: var(--fc-container);
      margin: 0 auto;
      padding-inline: var(--fc-gutter);
    }

    #family-combo-{{ section.id }} .family-combo__header {
      max-width: 720px;
      margin-bottom: clamp(1.75rem, 3vw, 3rem);
    }

    #family-combo-{{ section.id }} .family-combo__eyebrow,
    #family-combo-{{ section.id }} .family-combo__step-kicker {
      margin: 0 0 .65rem;
      color: var(--fc-muted);
      font-size: .68rem;
      font-weight: 600;
      letter-spacing: .26em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    #family-combo-{{ section.id }} .family-combo__title {
      margin: 0;
      font-family: var(--fc-serif);
      font-size: clamp(2rem, 4vw, 3.25rem);
      font-weight: 600;
      letter-spacing: -.035em;
      line-height: 1.02;
    }

    #family-combo-{{ section.id }} .family-combo__intro {
      max-width: 620px;
      margin-top: .9rem;
      color: var(--fc-muted);
      font-size: .88rem;
      font-weight: 300;
      line-height: 1.65;
    }

    #family-combo-{{ section.id }} .family-combo__intro p {
      margin: 0;
    }

    #family-combo-{{ section.id }} .family-combo__builder {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.5rem, 4vw, 4rem);
      align-items: stretch;
    }

    #family-combo-{{ section.id }} .family-combo__visual-card {
      position: relative;
      min-height: 520px;
      aspect-ratio: 3 / 4;
      max-height: 760px;
      margin: 0;
      overflow: hidden;
      border-radius: 6px;
      background: #111;
      color: #fff;
    }

    #family-combo-{{ section.id }} .family-combo__media,
    #family-combo-{{ section.id }} .family-combo__overlay {
      position: absolute;
      inset: 0;
    }

    #family-combo-{{ section.id }} .family-combo__preview-image,
    #family-combo-{{ section.id }} .family-combo__placeholder {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: center top;
    }

    #family-combo-{{ section.id }} .family-combo__preview-image {
      transition: opacity .55s var(--fc-ease), transform 1.1s var(--fc-ease);
    }

    #family-combo-{{ section.id }} .family-combo__visual-card:hover .family-combo__preview-image {
      transform: scale(1.015);
    }

    #family-combo-{{ section.id }} .family-combo__overlay {
      background:
        radial-gradient(900px 520px at 8% 12%, rgb(0 0 0 / .22), transparent 55%),
        linear-gradient(to top, rgb(0 0 0 / .9) 0%, rgb(0 0 0 / .42) 42%, transparent 78%);
    }

    #family-combo-{{ section.id }} .family-combo__visual-content {
      position: relative;
      z-index: 2;
      display: flex;
      min-height: 100%;
      padding: clamp(1.15rem, 2.4vw, 2rem);
      flex-direction: column;
      justify-content: space-between;
    }

    #family-combo-{{ section.id }} .family-combo__tags {
      display: flex;
      gap: .55rem;
      align-items: center;
      font-size: .62rem;
      font-weight: 600;
      letter-spacing: .25em;
      line-height: 1.4;
      text-transform: uppercase;
      color: rgb(255 255 255 / .78);
    }

    #family-combo-{{ section.id }} .family-combo__selected-model {
      margin: 0 0 .55rem;
      font-size: .67rem;
      font-weight: 600;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: rgb(255 255 255 / .72);
    }

    #family-combo-{{ section.id }} .family-combo__visual-title {
      max-width: 90%;
      margin: 0;
      font-family: var(--fc-serif);
      font-size: clamp(1.65rem, 3vw, 2.5rem);
      font-weight: 500;
      letter-spacing: -.025em;
      line-height: 1.08;
    }

    #family-combo-{{ section.id }} .family-combo__visual-note {
      max-width: 520px;
      margin: 1rem 0 0;
      padding-top: 1rem;
      border-top: 1px solid rgb(255 255 255 / .28);
      color: rgb(255 255 255 / .78);
      font-size: .76rem;
      font-weight: 300;
      line-height: 1.55;
    }

    #family-combo-{{ section.id }} .family-combo__configurator {
      display: flex;
      min-width: 0;
      padding: clamp(1.25rem, 3vw, 2.4rem);
      flex-direction: column;
      border: 1px solid #e8e8e8;
      background: var(--fc-card-bg);
    }

    #family-combo-{{ section.id }} .family-combo__progress {
      margin-bottom: clamp(2rem, 4vw, 3.2rem);
    }

    #family-combo-{{ section.id }} .family-combo__progress-meta {
      display: flex;
      margin-bottom: .9rem;
      align-items: center;
      justify-content: space-between;
      color: var(--fc-muted);
      font-size: .64rem;
      font-weight: 600;
      letter-spacing: .2em;
      text-transform: uppercase;
    }

    #family-combo-{{ section.id }} .family-combo__progress-meta > span:last-child {
      display: flex;
      align-items: center;
      gap: .65rem;
      font-variant-numeric: tabular-nums;
    }

    #family-combo-{{ section.id }} .family-combo__progress-meta strong {
      color: var(--fc-text);
      font-weight: 700;
    }

    #family-combo-{{ section.id }} .family-combo__progress-meta i {
      width: 30px;
      height: 1px;
      display: block;
      background: #d9d9d9;
    }

    #family-combo-{{ section.id }} .family-combo__progress-track {
      position: relative;
      height: 1px;
      overflow: hidden;
      background: #e9e9e9;
    }

    #family-combo-{{ section.id }} .family-combo__progress-track span {
      position: absolute;
      inset: 0 auto 0 0;
      width: 33.333%;
      background: var(--fc-accent);
      transition: width .65s var(--fc-ease);
    }

    #family-combo-{{ section.id }} .family-combo__steps {
      position: relative;
      flex: 1;
    }

    #family-combo-{{ section.id }} .family-combo__step {
      animation: familyComboEnter-{{ section.id }} .5s var(--fc-ease) both;
    }

    #family-combo-{{ section.id }} .family-combo__step[hidden] {
      display: none !important;
    }

    @keyframes familyComboEnter-{{ section.id }} {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    #family-combo-{{ section.id }} .family-combo__step-title {
      margin: 0;
      font-family: var(--fc-serif);
      font-size: clamp(1.75rem, 3.2vw, 2.7rem);
      font-weight: 500;
      letter-spacing: -.035em;
      line-height: 1.04;
    }

    #family-combo-{{ section.id }} .family-combo__step-description {
      max-width: 410px;
      margin: .85rem 0 1.75rem;
      color: var(--fc-muted);
      font-size: .79rem;
      font-weight: 300;
      line-height: 1.55;
    }

    #family-combo-{{ section.id }} .family-combo__qty-list {
      display: flex;
      flex-direction: column;
      border-top: 1px solid #e6e6e6;
    }

    #family-combo-{{ section.id }} .family-combo__qty-card {
      width: 100%;
      display: grid;
      grid-template-columns: 46px minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: center;
      padding: 1rem 0;
      border: 0;
      border-bottom: 1px solid #e6e6e6;
      border-radius: 0;
      background: transparent;
      color: var(--fc-text);
      cursor: pointer;
      text-align: left;
      transition: padding .25s ease, opacity .25s ease;
    }

    #family-combo-{{ section.id }} .family-combo__qty-card:hover:not(:disabled),
    #family-combo-{{ section.id }} .family-combo__qty-card.is-selected {
      padding-inline: .7rem;
    }

    #family-combo-{{ section.id }} .family-combo__qty-card.is-selected {
      background: #f5f5f3;
    }

    #family-combo-{{ section.id }} .family-combo__qty-card:disabled {
      opacity: .38;
      cursor: not-allowed;
    }

    #family-combo-{{ section.id }} .family-combo__qty-number {
      font-family: var(--fc-serif);
      font-size: 1.55rem;
      line-height: 1;
    }

    #family-combo-{{ section.id }} .family-combo__qty-copy {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: .2rem;
    }

    #family-combo-{{ section.id }} .family-combo__qty-copy strong {
      overflow: hidden;
      font-size: .8rem;
      font-weight: 600;
      letter-spacing: .04em;
      text-overflow: ellipsis;
      text-transform: uppercase;
      white-space: nowrap;
    }

    #family-combo-{{ section.id }} .family-combo__qty-copy small {
      color: var(--fc-muted);
      font-size: .72rem;
      font-weight: 300;
    }

    #family-combo-{{ section.id }} .family-combo__qty-copy em {
      margin-top: .25rem;
      color: var(--fc-text);
      font-size: .72rem;
      font-style: normal;
      font-weight: 600;
    }

    #family-combo-{{ section.id }} .family-combo__qty-arrow {
      font-size: 1rem;
      transition: transform .25s ease;
    }

    #family-combo-{{ section.id }} .family-combo__qty-card:hover .family-combo__qty-arrow {
      transform: translateX(3px);
    }

    #family-combo-{{ section.id }} .family-combo__models {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .8rem;
    }

    #family-combo-{{ section.id }} .family-combo__model-card {
      position: relative;
      min-width: 0;
      padding: 0;
      overflow: hidden;
      border: 1px solid #e3e3e3;
      border-radius: 0;
      background: #fff;
      color: #111;
      cursor: pointer;
      text-align: left;
      transition: border-color .25s ease, transform .35s var(--fc-ease);
    }

    #family-combo-{{ section.id }} .family-combo__model-card:hover:not(:disabled) {
      transform: translateY(-2px);
      border-color: #111;
    }

    #family-combo-{{ section.id }} .family-combo__model-card.is-selected {
      border-color: #111;
      box-shadow: inset 0 0 0 1px #111;
    }

    #family-combo-{{ section.id }} .family-combo__model-card:disabled {
