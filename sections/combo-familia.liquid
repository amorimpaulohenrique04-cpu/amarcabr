        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
      }
    }
  </style>

  <script type="module">
    (() => {
      const root = document.getElementById('family-combo-{{ section.id }}');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      try {
        const builder = root.querySelector('.family-combo__builder');
        const models = JSON.parse(builder?.dataset.models || '[]');
        const comboVariants = JSON.parse(builder?.dataset.comboVariants || '[]');
        const sizeOrder = (builder?.dataset.sizeOrder || '')
          .split(',')
          .map(value => value.trim())
          .filter(Boolean);

        const configuredVariantIds = {
          3: builder?.dataset.variant3 || '',
          4: builder?.dataset.variant4 || '',
          5: builder?.dataset.variant5 || ''
        };

        const compositionMap = {
          3: '2 Adultos + 1 Infantil',
          4: '2 Adultos + 2 Infantis',
          5: '2 Adultos + 3 Infantis'
        };

        const state = {
          step: 1,
          qty: null,
          modelId: null,
          selections: {}
        };

        const steps = [...root.querySelectorAll('[data-step]')];
        const qtyButtons = [...root.querySelectorAll('[data-qty]')];
        const modelList = root.querySelector('[data-model-list]');
        const sizesContainer = root.querySelector('[data-sizes-container]');
        const currentStep = root.querySelector('[data-current-step]');
        const progressFill = root.querySelector('[data-progress-fill]');
        const prevButton = root.querySelector('[data-prev]');
        const nextButton = root.querySelector('[data-next]');
        const nextLabel = root.querySelector('[data-next-label]');
        const totalPrice = root.querySelector('[data-total-price]');
        const comparePrice = root.querySelector('[data-compare-price]');
        const compositionLabel = root.querySelector('[data-composition-label]');
        const previewComposition = root.querySelector('[data-preview-composition]');
        const previewModel = root.querySelector('[data-preview-model]');
        const previewImage = root.querySelector('[data-main-preview]');
        const status = root.querySelector('[data-status]');
        const form = root.querySelector('[data-atc-form]');

        const getModel = () => models.find(model => String(model.id) === String(state.modelId));

        function setStatus(message = '', isError = false) {
          if (!status) return;
          status.textContent = message;
          status.hidden = !message;
          status.style.borderColor = isError ? '#e2bcbc' : '#cfdac7';
          status.style.background = isError ? '#fff7f7' : '#f7fbf4';
          status.style.color = isError ? '#8b2929' : '#36542f';
        }

        function resolveComboVariant(qty) {
          const configuredId = configuredVariantIds[qty];
          if (configuredId) {
            const byConfiguredId = comboVariants.find(variant => String(variant.id) === String(configuredId));
            if (byConfiguredId) return byConfiguredId;
          }

          const exactTitle = comboVariants.find(variant => String(variant.title).trim() === String(qty));
          if (exactTitle) return exactTitle;

          const numberPattern = new RegExp(`(^|\\D)${qty}(\\D|$)`);
          return comboVariants.find(variant => numberPattern.test(String(variant.title))) || null;
        }

        function variantsByType(model, type) {
          return model?.variants?.filter(variant => variant.type === type) || [];
        }

        function getOptions(variants) {
          const colors = new Set();
          const sizes = new Set();

          variants.forEach(variant => {
            (variant.options || []).forEach(option => {
              if (sizeOrder.includes(option)) sizes.add(option);
              else if (option && option !== 'Default Title') colors.add(option);
            });
          });

          const sortedSizes = [...sizes].sort((a, b) => {
            const indexA = sizeOrder.indexOf(a);
            const indexB = sizeOrder.indexOf(b);
            if (indexA === -1 && indexB === -1) return String(a).localeCompare(String(b), 'pt-BR');
            if (indexA === -1) return 1;
            if (indexB === -1) return -1;
            return indexA - indexB;
          });

          return { colors: [...colors], sizes: sortedSizes };
        }

        function findVariant(variants, color, size) {
          return variants.find(variant => {
            const options = variant.options || [];
            const matchesColor = color ? options.includes(color) : true;
            const matchesSize = size ? options.includes(size) : true;
            return matchesColor && matchesSize;
          });
        }

        function isAvailable(variants, color, size) {
          return Boolean(findVariant(variants, color, size)?.available);
        }

        function rowMeta(index) {
          if (index === 1) return { type: 'adult', title: 'Adulto 1', note: 'Camiseta adulta' };
          if (index === 2) return { type: 'adult', title: 'Adulto 2', note: 'Camiseta adulta' };
          if (index === 3) return { type: 'kids', title: 'Infantil 1', note: 'Peça obrigatória' };
          return { type: 'kids', title: `Infantil ${index - 2}`, note: 'Infantil extra' };
        }

        function createOption(value, label = value, disabled = false, selected = false) {
          const option = document.createElement('option');
          option.value = value;
          option.textContent = label;
          option.disabled = disabled;
          option.selected = selected;
          return option;
        }

        function updatePrice() {
          const variant = state.qty ? resolveComboVariant(state.qty) : null;

          qtyButtons.forEach(button => {
            const qty = Number(button.dataset.qty);
            const priceNode = root.querySelector(`[data-qty-price="${qty}"]`);
            const qtyVariant = resolveComboVariant(qty);

            button.disabled = !qtyVariant || !qtyVariant.available;
            button.setAttribute('aria-disabled', String(button.disabled));

            if (priceNode) {
              priceNode.textContent = qtyVariant
                ? (qtyVariant.available ? qtyVariant.price_formatted : 'Indisponível')
                : 'Configure a variante';
            }
          });

          if (!variant) return;

          if (totalPrice) totalPrice.textContent = variant.price_formatted;

          if (comparePrice) {
            const showCompare = Boolean(variant.compare_at_formatted && variant.compare_at_price > variant.price);
            comparePrice.hidden = !showCompare;
            comparePrice.textContent = showCompare ? variant.compare_at_formatted : '';
          }
        }

        function updatePreview() {
          const composition = state.qty ? compositionMap[state.qty] : compositionMap[3];
          const model = getModel();

          if (compositionLabel) compositionLabel.textContent = composition;
          if (previewComposition) previewComposition.textContent = composition;
          if (previewModel) previewModel.textContent = model?.title || '{{ section.settings.combo_title | escape }}';

          if (previewImage && model?.featured_image && previewImage.src !== model.featured_image) {
            previewImage.style.opacity = '0';
            window.setTimeout(() => {
              previewImage.src = model.featured_image;
              previewImage.removeAttribute('srcset');
              previewImage.style.opacity = '1';
            }, 180);
          }
        }

        function canAdvance() {
          if (state.step === 1) return Boolean(state.qty && resolveComboVariant(state.qty)?.available);
          if (state.step === 2) return Boolean(state.modelId);

          if (state.step === 3) {
            const model = getModel();
            if (!model || !state.qty) return false;

            for (let index = 1; index <= state.qty; index += 1) {
              const meta = rowMeta(index);
              const variants = variantsByType(model, meta.type);
              const options = getOptions(variants);
              const selection = state.selections[index] || {};

              if (!selection.size) return false;
              if (options.colors.length && !selection.color) return false;
              if (!isAvailable(variants, options.colors.length ? selection.color : null, selection.size)) return false;
            }

            return true;
          }

          return false;
        }

        function updateUI() {
          steps.forEach(step => {
            const isCurrent = Number(step.dataset.step) === state.step;
            step.hidden = !isCurrent;
            step.classList.toggle('is-active', isCurrent);
          });

          if (currentStep) currentStep.textContent = `0${state.step}`;
          if (progressFill) progressFill.style.width = `${(state.step / 3) * 100}%`;
          if (prevButton) prevButton.disabled = state.step === 1;
          if (nextButton) nextButton.disabled = !canAdvance();
          if (nextLabel) nextLabel.textContent = state.step === 3 ? 'Adicionar combo' : 'Próximo';

          qtyButtons.forEach(button => {
            const selected = Number(button.dataset.qty) === state.qty;
            button.classList.toggle('is-selected', selected);
            button.setAttribute('aria-pressed', String(selected));
          });

          updatePrice();
          updatePreview();
        }

        function goToStep(step) {
          if (step < 1 || step > 3) return;
          state.step = step;
          setStatus('');
          updateUI();

          const activeStep = root.querySelector(`[data-step="${step}"]`);
          activeStep?.querySelector('button:not(:disabled), select:not(:disabled)')?.focus({ preventScroll: true });
        }

        function renderModels() {
          if (!modelList) return;
          modelList.replaceChildren();

          if (!models.length) {
            const empty = document.createElement('div');
            empty.className = 'family-combo__empty';
            empty.textContent = 'Nenhuma estampa válida foi encontrada. Vincule produtos adultos ao combo e configure o produto infantil correspondente no metafield custom.kids_product.';
            modelList.appendChild(empty);
            return;
          }

          models.forEach(model => {
            const adultAvailable = variantsByType(model, 'adult').some(variant => variant.available);
            const kidsAvailable = variantsByType(model, 'kids').some(variant => variant.available);
            const available = adultAvailable && kidsAvailable;

            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'family-combo__model-card';
            button.disabled = !available;
            button.dataset.modelId = model.id;
            button.setAttribute('aria-pressed', String(String(state.modelId) === String(model.id)));
            button.classList.toggle('is-selected', String(state.modelId) === String(model.id));

            const imageMarkup = model.featured_image
              ? `<div class="family-combo__model-image-wrap"><img src="${model.featured_image}" alt="" class="family-combo__model-image" loading="lazy"></div>`
              : '<div class="family-combo__model-image-wrap"></div>';

            button.innerHTML = `${imageMarkup}<span class="family-combo__model-copy"><span>${model.title}</span><span aria-hidden="true">${available ? '→' : '—'}</span></span>`;

            button.addEventListener('click', () => {
              if (!available) return;
              state.modelId = String(model.id);
              state.selections = {};
              renderModels();
              renderSizeRows();
              updateUI();
              window.setTimeout(() => goToStep(3), 220);
            });

            modelList.appendChild(button);
          });
        }

        function renderSizeRows() {
          if (!sizesContainer) return;
          sizesContainer.replaceChildren();

          const model = getModel();
          if (!model || !state.qty) return;

          for (let index = 1; index <= state.qty; index += 1) {
            const meta = rowMeta(index);
            const variants = variantsByType(model, meta.type);
            const options = getOptions(variants);
            const hasColors = options.colors.length > 0;
            const selection = state.selections[index] || {};

            if (!state.selections[index]) state.selections[index] = {};
            if (hasColors && options.colors.length === 1 && !selection.color) {
              state.selections[index].color = options.colors[0];
              selection.color = options.colors[0];
            }

            const row = document.createElement('div');
            row.className = `family-combo__size-row${hasColors ? '' : ' has-no-color'}`;

            const person = document.createElement('div');
            person.className = 'family-combo__person';
            person.innerHTML = `<strong>${meta.title}</strong><small>${meta.note}</small>`;
            row.appendChild(person);

            if (hasColors) {
              const colorField = document.createElement('div');
              colorField.className = 'family-combo__field';

              const colorLabel = document.createElement('label');
              colorLabel.htmlFor = `family-combo-color-{{ section.id }}-${index}`;
              colorLabel.textContent = 'Cor';

              const colorSelect = document.createElement('select');
              colorSelect.id = colorLabel.htmlFor;
              colorSelect.className = 'family-combo__select';
              colorSelect.appendChild(createOption('', 'Escolha', false, !selection.color));

              options.colors.forEach(color => {
                const colorAvailable = variants.some(variant => variant.available && (variant.options || []).includes(color));
                colorSelect.appendChild(createOption(color, colorAvailable ? color : `${color} — Esgotado`, !colorAvailable, selection.color === color));
              });

              colorSelect.addEventListener('change', event => {
                state.selections[index].color = event.target.value;
                state.selections[index].size = '';
                renderSizeRows();
                updateUI();
              });

              colorField.append(colorLabel, colorSelect);
              row.appendChild(colorField);
            }

            const sizeField = document.createElement('div');
            sizeField.className = 'family-combo__field';

            const sizeLabel = document.createElement('label');
            sizeLabel.htmlFor = `family-combo-size-{{ section.id }}-${index}`;
            sizeLabel.textContent = 'Tamanho';

            const sizeSelect = document.createElement('select');
            sizeSelect.id = sizeLabel.htmlFor;
            sizeSelect.className = 'family-combo__select';
            sizeSelect.disabled = hasColors && !selection.color;
            sizeSelect.appendChild(createOption('', sizeSelect.disabled ? 'Escolha a cor' : 'Escolha', false, !selection.size));

            options.sizes.forEach(size => {
              const available = isAvailable(variants, hasColors ? selection.color : null, size);
              sizeSelect.appendChild(createOption(size, available ? size : `${size} — Esgotado`, !available, selection.size === size));
            });

            sizeSelect.addEventListener('change', event => {
              state.selections[index].size = event.target.value;
              updateUI();
            });

            sizeField.append(sizeLabel, sizeSelect);
            row.appendChild(sizeField);
            sizesContainer.appendChild(row);
          }
        }

        qtyButtons.forEach(button => {
          button.addEventListener('click', () => {
            const qty = Number(button.dataset.qty);
            const variant = resolveComboVariant(qty);
            if (!variant?.available) return;

            state.qty = qty;
            state.selections = Object.fromEntries(
              Object.entries(state.selections).filter(([index]) => Number(index) <= qty)
            );

            renderSizeRows();
            updateUI();
            window.setTimeout(() => goToStep(2), 220);
          });
        });

        prevButton?.addEventListener('click', () => goToStep(state.step - 1));

        nextButton?.addEventListener('click', () => {
          if (!canAdvance()) return;
          if (state.step < 3) goToStep(state.step + 1);
          else submitCombo();
        });

        async function submitCombo() {
          const comboVariant = resolveComboVariant(state.qty);
          const model = getModel();

          if (!comboVariant?.id || !model || !canAdvance()) {
            setStatus('Revise a composição, a estampa e todos os tamanhos antes de adicionar.', true);
            return;
          }

          const selectionLines = [];
          for (let index = 1; index <= state.qty; index += 1) {
            const meta = rowMeta(index);
            const selection = state.selections[index];
            const parts = [];
            if (selection.color) parts.push(selection.color);
            parts.push(`Tam. ${selection.size}`);
            selectionLines.push(`${meta.title}: ${parts.join(' / ')}`);
          }

          form.querySelector('[data-variant-input]').value = comboVariant.id;
          form.querySelector('[data-prop="composition"]').value = compositionMap[state.qty];
          form.querySelector('[data-prop="model"]').value = model.title;
          form.querySelector('[data-prop="selection"]').value = selectionLines.join(' | ');
          form.querySelector('[data-prop="qty"]').value = state.qty;
          form.querySelector('[data-prop="adult-product"]').value = model.adult_product_id || '';
          form.querySelector('[data-prop="kids-product"]').value = model.kids_product_id || '';

          nextButton.disabled = true;
          nextLabel.textContent = 'Adicionando...';
          setStatus('');

          let cartEvents;
          try {
            const formData = new FormData(form);
            const modules = await Promise.all([import('@theme/cart-service'), import('@theme/events')]);
            const cartApi = modules[0];
            cartEvents = modules[1];
            const result = await cartApi.cartService.add(formData, { sections: cartApi.getCartSectionIds() });
            document.dispatchEvent(new cartEvents.CartAddEvent(result.resource, 'combo-familia', {
              source: 'combo-familia', operation: 'add', itemCount: result.itemCount,
              cart: result.cart, sections: result.sections
            }));

            setStatus('Combo adicionado ao carrinho.', false);
            nextLabel.textContent = 'Adicionado';
          } catch (error) {
            console.error('Family Combo Builder:', error);
            if (cartEvents) document.dispatchEvent(new cartEvents.CartErrorEvent('combo-familia', error.message, error.description, error.errors, {
              source: 'combo-familia', operation: 'add', status: error.status
            }));
            setStatus(error.message || 'Ocorreu um erro ao adicionar o combo.', true);
            nextLabel.textContent = 'Tentar novamente';
          } finally {
            nextButton.disabled = !canAdvance();
            window.setTimeout(() => {
              if (nextLabel.textContent === 'Adicionado') nextLabel.textContent = 'Adicionar combo';
            }, 1800);
          }
        }

        renderModels();
        renderSizeRows();
        updateUI();
      } catch (error) {
        console.error('Family Combo Builder initialization error:', error);
      }
    })();
  </script>
</section>

