{%- comment -%}
  Editorial Product Grid - V9 (Schema Cleaned, Editable Pill Button, Header Alignment Fix)
  + "Você também vai gostar" (não mostra o produto atual no PDP)
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }}{
    /* Grid Layout */
    --grid-desktop: {{ section.settings.columns_desktop }};
    --grid-tablet: {{ section.settings.columns_tablet }};
    --grid-mobile: {{ section.settings.columns_mobile }};
    --gap: {{ section.settings.grid_gap }}px;

    /* Colors */
    --card-bg: {{ section.settings.card_bg }};
    --heading-color: {{ section.settings.heading_color }};
    --price-color: {{ section.settings.price_color }};
    
    /* Card Shape */
    --radius: {{ section.settings.card_radius }}px;
    --aspect-ratio: {{ section.settings.image_ratio }};

    /* Badges */
    --badge-bg: {{ section.settings.badge_bg }};
    --badge-text: {{ section.settings.badge_text }};

    /* Fonts */
    --font-body: 'Inter', sans-serif;
    
    /* --- CTA BUTTON SETTINGS (NEW) --- */
    /* Desktop Pill */
    --cta-desktop-min-width: {{ section.settings.cta_desktop_width }}px;
    --cta-desktop-font-size: {{ section.settings.cta_desktop_font_size }}px;
    --cta-desktop-padding: {{ section.settings.cta_desktop_padding }}px;
    
    /* Mobile Button */
    --cta-mobile-size: {{ section.settings.cta_mobile_size }}px;
  }

  .eurus-grid{
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    max-width: 100%;
    display: block;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* --- ALINHAMENTO COM HEADER (desktop, tablet e mobile) --- */
  .eurus-grid__wrapper{
    max-width: var(--am-header-max, var(--page-width, {{ section.settings.section_max_width }}px));
    margin-inline: auto;
    padding-inline: var(--am-header-x, var(--page-margin, 16px));
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }
  /* Fix explícito para tablet (750–989px) — evita desalinhamento */
  @media (min-width: 750px) and (max-width: 989px) {
    .eurus-grid__wrapper {
      padding-inline: var(--am-header-x, var(--page-margin, 16px));
      max-width: var(--am-header-max, var(--page-width, {{ section.settings.section_max_width }}px));
    }
    .eurus-grid__container {
      width: 100%;
      max-width: 100%;
    }
  }

  /* Header da Seção */
  .eurus-grid__header{
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: {{ section.settings.title_gap }}px;
    margin: 0 0 24px 0;
    row-gap: 8px;
  }
  .eurus-grid__icon{ display: inline-flex; width: {{ section.settings.title_icon_size }}px; height: {{ section.settings.title_icon_size }}px; flex: 0 0 auto; }
  .eurus-grid__icon img{ width: 100%; height: 100%; object-fit: contain; display: block; }
  .eurus-grid__header-left{ display: flex; align-items: center; gap: {{ section.settings.title_gap }}px; }
  .eurus-grid__view-all{
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: {{ section.settings.title_color }};
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: auto;
  }
  .eurus-grid__view-all:hover{ opacity: 1; }
  
  .eurus-grid__title{
    font-family: var(--font-body);
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.1;
    color: {{ section.settings.title_color }};
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* Grid Container - minmax(0,1fr) evita overflow em mobile */
  .eurus-grid__container{
    display: grid;
    grid-template-columns: repeat(var(--grid-mobile), minmax(0, 1fr));
    gap: var(--gap);
    width: 100%;
    min-width: 0;
  }
  @media (min-width: 768px){ .eurus-grid__container{ grid-template-columns: repeat(var(--grid-tablet), minmax(0, 1fr)); } }
  @media (min-width: 1024px){ .eurus-grid__container{ grid-template-columns: repeat(var(--grid-desktop), minmax(0, 1fr)); } }

{%- endstyle -%}
{%- liquid
  case section.settings.columns_desktop
    when 1
      assign am_sizes_desktop = '100vw'
    when 2
      assign am_sizes_desktop = '50vw'
    when 3
      assign am_sizes_desktop = '33vw'
    else
      assign am_sizes_desktop = '25vw'
  endcase

  case section.settings.columns_tablet
    when 1
      assign am_sizes_tablet = '100vw'
    when 2
      assign am_sizes_tablet = '50vw'
    else
      assign am_sizes_tablet = '33vw'
  endcase

  case section.settings.columns_mobile
    when 1
      assign am_sizes_mobile = '100vw'
    else
      assign am_sizes_mobile = '50vw'
  endcase

  assign am_card_sizes = '(min-width: 1200px) ' | append: am_sizes_desktop | append: ', (min-width: 750px) ' | append: am_sizes_tablet | append: ', ' | append: am_sizes_mobile
-%}


<div class="eurus-grid" id="editorial-grid-{{ section.id }}">
  <div class="eurus-grid__wrapper am-page-width">

    {%- assign view_all_url = section.settings.view_all_link | default: section.settings.collection.url -%}
    {%- assign has_view_all = false -%}
    {%- if section.settings.show_view_all_link and view_all_url != blank -%}
      {%- assign has_view_all = true -%}
    {%- endif -%}
    {%- if section.settings.show_title or has_view_all -%}
      <div class="eurus-grid__header">
        {%- if section.settings.show_title -%}
          <div class="eurus-grid__header-left">
            {%- if section.settings.title_icon != blank -%}
              <span class="eurus-grid__icon" aria-hidden="true">
                {{ section.settings.title_icon | image_url: width: 120 | image_tag: loading: 'lazy' }}
              </span>
            {%- endif -%}
            <h2 class="eurus-grid__title">{{ section.settings.title_text }}</h2>
          </div>
        {%- endif -%}
        {%- if has_view_all -%}
          <a href="{{ view_all_url }}" class="eurus-grid__view-all" aria-label="{{ section.settings.view_all_text | escape }}">
            {{ section.settings.view_all_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="eurus-grid__container" role="list">
      {%- assign shown_count = 0 -%}
      {%- assign current_product_id = product.id -%}

      {%- for p in section.settings.collection.products -%}
        {%- if template contains 'product' and p.id == current_product_id -%}
          {%- continue -%}
        {%- endif -%}

        {%- if shown_count >= section.settings.products_to_show -%}
          {%- break -%}
        {%- endif -%}
        {%- assign shown_count = shown_count | plus: 1 -%}

        {%- render 'am-product-card',
          product: p,
          section_id: section.id,
          image_sizes: am_card_sizes,
          image_ratio: section.settings.image_ratio,
          loading: 'lazy',
          enable_hover_image: section.settings.enable_hover_image,
          show_installments: section.settings.show_installments,
          sale_metafield_namespace: section.settings.sale_metafield_namespace,
          sale_metafield_key: section.settings.sale_metafield_key,
          sale_label: section.settings.sale_label,
          quick_buy_label: section.settings.hover_cta_label
        -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script defer>
(function(){
  const SECTION_ID = '{{ section.id }}';

  function findHeaderSource(){
    return document.querySelector(
      '[data-section-type*="header"] .page-width, header .page-width,' +
      '[data-section-type*="header"], .shopify-section--header, header'
    ) || document.documentElement;
  }

  function syncHeaderVars(){
    const root = document.querySelector('#editorial-grid-' + SECTION_ID);
    if (!root) return;
    const fromEl = findHeaderSource();
    const cs = window.getComputedStyle(fromEl);
    const x = (cs.getPropertyValue('--am-header-x') || '').trim();
    const max = (cs.getPropertyValue('--am-header-max') || '').trim();
    if (x) root.style.setProperty('--am-header-x', x);
    if (max) root.style.setProperty('--am-header-max', max);
  }

  function rafSync(){
    requestAnimationFrame(() => requestAnimationFrame(syncHeaderVars));
  }

  document.addEventListener('DOMContentLoaded', rafSync);
  window.addEventListener('load', rafSync);
  let t;
  window.addEventListener('resize', () => { clearTimeout(t); t = setTimeout(rafSync, 80); }, { passive: true });
  window.addEventListener('orientationchange', () => setTimeout(rafSync, 120));
  document.addEventListener('shopify:section:load', (e) => { if (e?.detail?.sectionId === SECTION_ID) rafSync(); });
  document.addEventListener('shopify:section:select', (e) => { if (e?.detail?.sectionId === SECTION_ID) rafSync(); });
  document.addEventListener('shopify:section:deselect', (e) => { if (e?.detail?.sectionId === SECTION_ID) rafSync(); });

})();
</script>

