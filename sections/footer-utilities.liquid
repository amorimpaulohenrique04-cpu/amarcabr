<style> 
  .footer-section { 
    background-color: {{ section.settings.bg_color }}; 
    color: {{ section.settings.text_color }}; 
    /* REDUZIDO: Menos padding vertical para diminuir a altura total */ 
    padding: 2rem 1rem; 
    font-family: 'Inter', sans-serif; 
    overflow: hidden; 
  } 
  .footer-container { 
    max-width: 1200px; 
    margin: 0 auto; 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
    /* REDUZIDO: Gap vertical diminuído de 4rem para 2.5rem */ 
    gap: 2.5rem 2rem; 
    align-items: start; 
  } 
  /* --- Esquerda: Marca & Newsletter --- */ 
  .footer-brand { 
    display: flex; 
    flex-direction: column; 
    justify-content: center; 
  } 
  .footer-logo-img { 
    max-width: {{ section.settings.logo_width }}px; 
    height: auto; 
    display: block; 
    margin-bottom: 1rem; /* Margem reduzida */ 
  } 
  .footer-headline { 
    font-family: 'Anton', sans-serif; 
    /* REDUZIDO: Fonte um pouco menor para economizar altura */ 
    font-size: clamp(1.8rem, 3.5vw, 2.5rem); 
    line-height: 1.1; 
    text-transform: uppercase; 
    margin-bottom: 1.5rem; /* Margem padrão reduzida */ 
  } 
  .text-accent { 
    color: {{ section.settings.accent_color }}; 
    display: block; 
  } 
  /* --- Texto Versiculo --- */
  .footer-verse {
    font-size: 0.65rem; /* Texto bem pequeno */
    font-style: italic;
    opacity: 0.75;
    margin-bottom: 1.5rem; /* Margem para separar da newsletter */
  }
  /* --- Design de Newsletter Compacto --- */ 
  .newsletter-form-wrapper { 
    position: relative; 
    max-width: 380px; 
    margin-bottom: 0.75rem; 
    border-bottom: 1px solid rgba(255,255,255,0.3); 
    transition: border-color 0.3s; 
  } 
  .newsletter-form-wrapper:focus-within { 
    border-bottom-color: {{ section.settings.accent_color }}; 
  } 
  .newsletter-input { 
    width: 100%; 
    padding: 0.75rem 3rem 0.75rem 0; /* Padding interno reduzido */ 
    border: none; 
    background: transparent; 
    color: inherit; 
    font-size: 0.95rem; 
    outline: none; 
  } 
  .newsletter-input::placeholder { 
    color: rgba(255,255,255,0.5); 
  } 
  .newsletter-btn { 
    position: absolute; 
    right: 0; 
    top: 50%; 
    transform: translateY(-50%); 
    background: transparent; 
    border: none; 
    color: inherit; 
    cursor: pointer; 
    padding: 0.5rem; 
    transition: transform 0.2s, color 0.2s; 
  } 
  .newsletter-btn:hover { 
    color: {{ section.settings.accent_color }}; 
    transform: translateY(-50%) translateX(3px); 
  } 
  /* --- Direita: Links & Icones --- */ 
  .footer-nav-grid { 
    display: grid; 
    grid-template-columns: repeat(2, 1fr); 
    gap: 1.5rem; /* Gap reduzido */ 
  } 
  .footer-col-title { 
    font-size: 0.7rem; 
    font-weight: 700; 
    text-transform: uppercase; 
    letter-spacing: 0.1em; 
    margin-bottom: 1rem; /* Margem reduzida */ 
    opacity: 0.8; 
  } 
  .footer-link-list { 
    list-style: none; 
    padding: 0; 
    margin: 0; 
  } 
  .footer-link { 
    display: block; 
    text-decoration: none; 
    color: inherit; 
    font-size: 0.9rem; 
    margin-bottom: 0.5rem; /* Margem entre links reduzida */ 
    transition: opacity 0.2s; 
  } 
  .footer-link:hover { 
    opacity: 0.7; 
  } 
  /* --- Features Icons --- */ 
  .feature-icons { 
    margin-top: 2rem; /* Margem superior reduzida de 3rem para 2rem */ 
    display: flex; 
    gap: 1.5rem; 
    flex-wrap: wrap; 
  } 
  .feature-item { 
    display: flex; 
    align-items: center; 
    gap: 0.5rem; 
  } 
  .feature-icon-box { 
    width: 32px; /* Ícone levemente menor */ 
    height: 32px; 
    border: 1px solid rgba(255,255,255,0.2); 
    border-radius: 50%; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    color: {{ section.settings.accent_color }}; 
  } 
  .feature-text { 
    font-size: 0.65rem; 
    font-weight: 600; 
    text-transform: uppercase; 
    max-width: 100px; 
    line-height: 1.2; 
  } 
  /* --- Rodapé Inferior --- */ 
  .footer-bottom { 
    /* REDUZIDO: Margem superior cortada pela metade */ 
    margin-top: 2rem; 
    padding-top: 1.5rem; 
    border-top: 1px solid rgba(255,255,255,0.1); 
    display: flex; 
    flex-wrap: wrap; 
    justify-content: space-between; 
    align-items: center; 
    gap: 1rem; 
    font-size: 0.7rem; 
    opacity: 0.7; 
  } 
  .footer-legal a { 
    color: inherit; 
    text-decoration: none; 
    margin-right: 1rem; 
  } 
  .footer-legal a:hover { 
    text-decoration: underline; 
  } 
</style>

<div class="footer-section"> 
  <div class="footer-container">
    <div class="footer-brand">
      {% if section.settings.logo != blank %}
        <img 
          src="{{ section.settings.logo | image_url: width: 300 }}" 
          alt="{{ shop.name }}" 
          class="footer-logo-img"
          width="{{ section.settings.logo_width }}"
          height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | ceil }}"
          loading="lazy"
        >
      {% else %}
        <h2 style="margin-bottom: 1rem; font-weight: 800; font-size: 1.5rem;">{{ shop.name }}</h2>
      {% endif %}

      <div class="footer-headline" {% if section.settings.verse_text != blank %}style="margin-bottom: 0.2rem;"{% endif %}>
        {{ section.settings.headline_1 }}
        <span class="text-accent">{{ section.settings.headline_accent }}</span>
      </div>

      {% if section.settings.verse_text != blank %}
        <div class="footer-verse">
          {{ section.settings.verse_text }}
        </div>
      {% endif %}

      {% form 'customer', class: 'newsletter-form' %}
        <div class="newsletter-form-wrapper">
          <input type="email" name="contact[email]" class="newsletter-input" placeholder="Seu melhor email" required>
          <button type="submit" class="newsletter-btn" aria-label="Subscribe">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </div>
      {% endform %}
      
      <p style="margin-top: 0.5rem; font-size: 0.75rem; opacity: 0.6; max-width: 380px;">
        {{ section.settings.newsletter_subtext }}
      </p>

      {% if section.settings.brand_info != blank %}
      <div style="margin-top: 1.5rem; font-size: 0.7rem; opacity: 0.5; white-space: pre-line; line-height: 1.4;">
        {{ section.settings.brand_info }}
      </div>
      {% endif %}
    </div>

    <div class="footer-nav">
      <div class="footer-nav-grid">
        <div>
          <h3 class="footer-col-title">{{ section.settings.menu_1_title }}</h3>
          <ul class="footer-link-list">
            {% for link in linklists[section.settings.menu_1].links %}
              <li><a href="{{ link.url }}" class="footer-link">{{ link.title }}</a></li>
            {% else %}
              <li><a href="#" class="footer-link">Home</a></li>
              <li><a href="#" class="footer-link">Shop</a></li>
            {% endfor %}
          </ul>
        </div>
        
        <div>
          <h3 class="footer-col-title">{{ section.settings.menu_2_title }}</h3>
          <ul class="footer-link-list">
            {% for link in linklists[section.settings.menu_2].links %}
              <li><a href="{{ link.url }}" class="footer-link">{{ link.title }}</a></li>
            {% else %}
              <li><a href="#" class="footer-link">Support</a></li>
              <li><a href="#" class="footer-link">Contact</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="feature-icons">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="feature-item">
              <div class="feature-icon-box">
                 {% case block.settings.icon %}
                   {% when 'ban' %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                   {% when 'flask' %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2v7.31"/><path d="M14 2v7.31"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/></svg>
                   {% else %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.77 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                 {% endcase %}
              </div>
              <span class="feature-text">{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div> 
  
  <div class="footer-container footer-bottom"> 
    <div class="footer-legal"> 
      <a href="/policies/privacy-policy">Privacy</a> 
      <a href="/policies/terms-of-service">Terms</a> 
      <a href="/policies/cookie-policy">Cookies</a> 
    </div>

    <div class="footer-socials">
       {% for block in section.blocks %}
         {% if block.type == 'social' %}
           <a href="{{ block.settings.link }}" style="margin-left: 0.8rem; text-decoration: none;">{{ block.settings.platform }}</a>
         {% endif %}
       {% endfor %}
    </div>

    <div class="footer-copyright">
      &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}.
    </div>
  </div> 
</div>

{% schema %}
{
  "name": "Footer Compact",
  "settings": [
    {
      "type": "header",
      "content": "Colors & Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#420D16"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FADADD"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (Icon/Text)",
      "default": "#FF4D6A"
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Logo Width",
      "default": 100
    },
    {
      "type": "text",
      "id": "headline_1",
      "label": "Main Headline",
      "default": "WHERE EVERY TREAT"
    },
    {
      "type": "text",
      "id": "headline_accent",
      "label": "Headline Accent",
      "default": "IS HEAVEN"
    },
    {
      "type": "text",
      "id": "verse_text",
      "label": "Verse (Small Italic Text)",
      "default": "\"Tudo posso naquele que me fortalece.\""
    },
    {
      "type": "textarea",
      "id": "newsletter_subtext",
      "label": "Newsletter Text",
      "default": "Join our list for sweet updates."
    },
    {
      "type": "textarea",
      "id": "brand_info",
      "label": "Footer Info",
      "default": "Your Brand Name Ltda."
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Header 1",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Header 2",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Badge",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Natural"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ban", "label": "Ban" },
            { "value": "flask", "label": "Flask" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "leaf"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social Link",
      "settings": [
        { "type": "text", "id": "platform", "label": "Name (e.g. Instagram)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Compact",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}