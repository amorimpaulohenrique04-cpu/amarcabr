{%- comment -%}
  A MARCA — Premium Collection Landing
  Commerce-first hierarchy: compact collection heading, products immediately,
  supporting SEO/editorial copy in a user-accessible accordion after the grid.
  Critical styles stay before markup to avoid FOUC.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: {{ section.settings.background }}; }
  .am-seo-collection { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; color: #111; }
  .am-seo-collection__inner { width: min(100% - 32px, 1200px); margin: 0 auto; }

  .am-seo-collection__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin: 0 0 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(17,17,17,.10);
  }
  .am-seo-collection__title {
    margin: 0;
    font-family: var(--font-body--family, 'Inter', sans-serif);
    font-size: clamp(22px,2vw,30px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -.025em;
    text-transform: none;
    color: #52201b;
  }
  .am-seo-collection__count {
    flex: 0 0 auto;
    font-family: var(--font-body--family, 'Inter', sans-serif);
    font-size: 10px;
    line-height: 1;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(17,17,17,.52);
  }

  .am-seo-collection__grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 20px; }
  .am-seo-card { min-width: 0; }
  .am-seo-card__media { position: relative; display: block; overflow: hidden; aspect-ratio: 3/4; border-radius: 8px; background: #f4f4f4; }
  .am-seo-card__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .35s ease, transform .6s ease; }
  .am-seo-card__image--secondary { opacity: 0; }
  .am-seo-card__content { padding: 12px 0 24px; }
  .am-seo-card__title { display: block; color: #111; text-decoration: none; font-size: 14px; line-height: 1.35; font-weight: 600; }
  .am-seo-card__price { display: flex; gap: 8px; align-items: baseline; margin-top: 5px; font-size: 14px; }
  .am-seo-card__compare { text-decoration: line-through; opacity: .48; font-size: 12px; }
  .am-seo-card__installments { margin-top: 3px; color: #666; font-size: 12px; }

  .am-seo-pagination { display: flex; align-items: center; justify-content: center; gap: 20px; padding-top: 24px; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  .am-seo-pagination a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }

  .am-seo-collection__about {
    margin-top: 44px;
    border-top: 1px solid rgba(17,17,17,.12);
    border-bottom: 1px solid rgba(17,17,17,.12);
  }
  .am-seo-collection__about summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    cursor: pointer;
    font-family: var(--font-body--family, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #52201b;
  }
  .am-seo-collection__about summary::-webkit-details-marker { display: none; }
  .am-seo-collection__about summary::after { content: '+'; font-size: 18px; font-weight: 300; line-height: 1; letter-spacing: 0; transition: transform .2s ease; }
  .am-seo-collection__about[open] summary::after { transform: rotate(45deg); }
  .am-seo-collection__description {
    max-width: 760px;
    padding: 0 0 24px;
    font-family: var(--font-body--family, 'Inter', sans-serif);
    font-size: 13px;
    line-height: 1.75;
    color: #4b4b4b;
  }
  .am-seo-collection__description p { margin: 0 0 12px; }
  .am-seo-collection__description h2,
  .am-seo-collection__description h3 { margin: 22px 0 9px; font-size: 13px; line-height: 1.35; letter-spacing: .04em; text-transform: none; color: #52201b; }
  .am-seo-collection__description a { color: inherit; text-underline-offset: 3px; }

  @media (hover:hover) {
    .am-seo-card__media:hover .am-seo-card__image--primary { opacity: 0; transform: scale(1.025); }
    .am-seo-card__media:hover .am-seo-card__image--secondary { opacity: 1; transform: scale(1.025); }
  }
  @media (max-width: 1023px) {
    .am-seo-collection__grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
  }
  @media (max-width: 749px) {
    .am-seo-collection { padding-top: 18px; }
    .am-seo-collection__inner { width: min(100% - 24px,1200px); }
    .am-seo-collection__header { margin-bottom: 18px; padding-bottom: 12px; }
    .am-seo-collection__title { font-size: 21px; }
    .am-seo-collection__count { font-size: 9px; }
    .am-seo-collection__grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
    .am-seo-card__content { padding-bottom: 18px; }
    .am-seo-collection__about { margin-top: 30px; }
    .am-seo-collection__description { font-size: 12.5px; }
  }
</style>

<section class="am-seo-collection" aria-labelledby="CollectionTitle-{{ section.id }}">
  <div class="am-seo-collection__inner">
    <header class="am-seo-collection__header">
      <h1 id="CollectionTitle-{{ section.id }}" class="am-seo-collection__title">{{ collection.title }}</h1>
      <span class="am-seo-collection__count">{{ collection.products_count }} {% if collection.products_count == 1 %}peça{% else %}peças{% endif %}</span>
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products_count > 0 -%}
        <div class="am-seo-collection__grid" role="list">
          {%- for product in collection.products -%}
            <article class="am-seo-card" role="listitem">
              <a class="am-seo-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {%- if product.featured_media != blank -%}
                  {%- assign primary_image = product.featured_media.preview_image -%}
                  <img
                    class="am-seo-card__image am-seo-card__image--primary"
                    src="{{ primary_image | image_url: width: 640 }}"
                    srcset="{{ primary_image | image_url: width: 320 }} 320w, {{ primary_image | image_url: width: 480 }} 480w, {{ primary_image | image_url: width: 640 }} 640w, {{ primary_image | image_url: width: 900 }} 900w"
                    sizes="(max-width: 749px) 50vw, (max-width: 1023px) 33vw, 25vw"
                    width="{{ primary_image.width }}"
                    height="{{ primary_image.height }}"
                    alt="{{ primary_image.alt | default: product.title | escape }}"
                    loading="{% if forloop.index <= 4 %}eager{% else %}lazy{% endif %}"
                    decoding="async"
                  >
                  {%- if section.settings.enable_hover_image and product.media[1] != blank -%}
                    {%- assign secondary_image = product.media[1].preview_image -%}
                    <img
                      class="am-seo-card__image am-seo-card__image--secondary"
                      src="{{ secondary_image | image_url: width: 640 }}"
                      srcset="{{ secondary_image | image_url: width: 320 }} 320w, {{ secondary_image | image_url: width: 480 }} 480w, {{ secondary_image | image_url: width: 640 }} 640w, {{ secondary_image | image_url: width: 900 }} 900w"
                      sizes="(max-width: 749px) 50vw, (max-width: 1023px) 33vw, 25vw"
                      width="{{ secondary_image.width }}"
                      height="{{ secondary_image.height }}"
                      alt="{{ secondary_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      decoding="async"
                    >
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'am-seo-card__placeholder' }}
                {%- endif -%}
              </a>

              <div class="am-seo-card__content">
                <a class="am-seo-card__title" href="{{ product.url }}">{{ product.title }}</a>
                <div class="am-seo-card__price">
                  <span>{{ product.price | money_without_trailing_zeros }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="am-seo-card__compare">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                  {%- endif -%}
                </div>
                {%- if section.settings.show_installments -%}
                  <div class="am-seo-card__installments">{%- render 'installment-3x', product: product -%}</div>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="am-seo-pagination" aria-label="Paginação da coleção">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev">← Anterior</a>{%- endif -%}
            <span>Página {{ paginate.current_page }} de {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next">Próxima →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="am-seo-collection__empty">Nenhum produto disponível nesta coleção no momento.</p>
      {%- endif -%}

      {%- if paginate.current_page == 1 and collection.description != blank -%}
        <details class="am-seo-collection__about">
          <summary>Sobre a coleção</summary>
          <div class="am-seo-collection__description rte">{{ collection.description }}</div>
        </details>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "SEO Collection",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Produtos por página", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "enable_hover_image", "label": "Segunda foto no hover", "default": true },
    { "type": "checkbox", "id": "show_installments", "label": "Mostrar parcelamento", "default": true },
    { "type": "color", "id": "background", "label": "Fundo", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Espaço superior", "min": 0, "max": 100, "step": 4, "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior", "min": 0, "max": 120, "step": 4, "default": 56 }
  ],
  "presets": [{ "name": "SEO Collection" }]
}
{% endschema %}
