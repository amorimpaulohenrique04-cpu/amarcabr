{% comment %}
  Newsletter Pop-up Editorial — visual neutro e reutilizável
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --np-bg: {{ section.settings.bg_color }};
    --np-panel: {{ section.settings.panel_color }};
    --np-text: {{ section.settings.text_color }};
    --np-accent: {{ section.settings.accent_color }};
    --np-border: rgba(17, 17, 17, 0.14);
    --np-muted: rgba(17, 17, 17, 0.62);
  }

  #shopify-section-{{ section.id }} .np-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.54);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    z-index: 9998;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.26s ease, visibility 0.26s ease;
  }

  #shopify-section-{{ section.id }} .np-overlay.np-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .np-modal {
    position: relative;
    width: min(100%, 860px);
    max-height: min(92vh, 720px);
    background: var(--np-bg);
    border: 1px solid rgba(255,255,255,0.16);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    transform: translateY(10px) scale(0.985);
    transition: transform 0.26s ease;
  }

  #shopify-section-{{ section.id }} .np-overlay.np-visible .np-modal {
    transform: translateY(0) scale(1);
  }

  @media (min-width: 900px) {
    #shopify-section-{{ section.id }} .np-modal {
      grid-template-columns: minmax(0, 0.44fr) minmax(0, 0.56fr);
    }
  }

  #shopify-section-{{ section.id }} .np-close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 40px;
    height: 40px;
    border: 1px solid var(--np-border);
    border-radius: 0;
    background: #fff;
    color: var(--np-text);
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }

  #shopify-section-{{ section.id }} .np-close:hover {
    background: #f5f5f5;
    border-color: rgba(17,17,17,0.28);
  }

  #shopify-section-{{ section.id }} .np-media {
    position: relative;
    min-height: 210px;
    background: #ecebea;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .np-image-wrap,
  #shopify-section-{{ section.id }} .np-image-wrap img {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .np-image-wrap img {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .np-placeholder-bg {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #f0efed, #d8d5d0);
  }

  #shopify-section-{{ section.id }} .np-placeholder-bg .np-placeholder {
    width: 38%;
    height: auto;
    opacity: 0.22;
  }

  #shopify-section-{{ section.id }} .np-form-panel {
    position: relative;
    background: var(--np-panel);
    overflow-y: auto;
    padding: 1.5rem 1.15rem 1.1rem;
  }

  @media (min-width: 640px) {
    #shopify-section-{{ section.id }} .np-form-panel {
      padding: 1.8rem 1.55rem 1.35rem;
    }
  }

  @media (min-width: 900px) {
    #shopify-section-{{ section.id }} .np-form-panel {
      padding: 2.4rem 2.15rem 1.65rem;
    }
  }

  #shopify-section-{{ section.id }} .np-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    align-content: center;
    min-height: 100%;
  }

  #shopify-section-{{ section.id }} .np-copy {
    display: grid;
    gap: 0.9rem;
    max-width: 30rem;
  }

  #shopify-section-{{ section.id }} .np-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    color: var(--np-text);
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .np-kicker-dot {
    width: 1.4rem;
    height: 1px;
    background: var(--np-accent);
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .np-title {
    margin: 0;
    display: grid;
    gap: 0.08rem;
    line-height: 1.02;
    max-width: 14ch;
  }

  #shopify-section-{{ section.id }} .np-title-line {
    display: block;
    font-size: clamp(1.65rem, 4vw, 2.65rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    color: var(--np-text);
  }

  #shopify-section-{{ section.id }} .np-title-line--alt {
    color: var(--np-accent);
  }

  #shopify-section-{{ section.id }} .np-desc {
    margin: 0;
    max-width: 28rem;
    font-size: 0.92rem;
    color: var(--np-muted);
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .np-form {
    display: grid;
    gap: 0.65rem;
    margin-top: 0.55rem;
  }

  #shopify-section-{{ section.id }} .np-input {
    width: 100%;
    min-height: 3rem;
    border: 1px solid var(--np-border);
    background: #fff;
    color: var(--np-text);
    padding: 0.9rem 0.95rem;
    font-size: 16px;
    outline: none;
    box-shadow: none;
    border-radius: 0;
  }

  #shopify-section-{{ section.id }} .np-input::placeholder {
    color: rgba(17,17,17,0.44);
  }

  #shopify-section-{{ section.id }} .np-input:focus {
    border-color: var(--np-accent);
  }

  #shopify-section-{{ section.id }} .np-submit {
    width: 100%;
    min-height: 3.05rem;
    border: 1px solid var(--np-accent);
    border-radius: 0;
    background: var(--np-accent);
    color: #fff;
    padding: 0.92rem 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  #shopify-section-{{ section.id }} .np-submit:hover {
    background: transparent;
    color: var(--np-accent);
  }

  #shopify-section-{{ section.id }} .np-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .np-footer {
    display: grid;
    gap: 0.65rem;
    margin-top: 0.4rem;
  }

  #shopify-section-{{ section.id }} .np-no-thanks {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--np-muted);
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    justify-self: start;
  }

  #shopify-section-{{ section.id }} .np-no-thanks:hover {
    color: var(--np-text);
  }

  #shopify-section-{{ section.id }} .np-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    font-size: 0.6rem;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(17,17,17,0.46);
  }

  #shopify-section-{{ section.id }} .np-links a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .np-success {
    display: none;
    text-align: left;
    padding-top: 0.75rem;
  }

  #shopify-section-{{ section.id }} .np-success h3 {
    margin: 0 0 0.42rem;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--np-text);
  }

  #shopify-section-{{ section.id }} .np-success p {
    margin: 0;
    color: var(--np-muted);
    line-height: 1.5;
  }

  @media (max-width: 899px) {
    #shopify-section-{{ section.id }} .np-modal {
      max-height: min(92vh, 720px);
      overflow-y: auto;
    }

    #shopify-section-{{ section.id }} .np-media {
      min-height: 180px;
      max-height: 250px;
    }
  }

  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .np-overlay {
      padding: 0.5rem;
    }

    #shopify-section-{{ section.id }} .np-media {
      min-height: 145px;
      max-height: 190px;
    }

    #shopify-section-{{ section.id }} .np-form-panel {
      padding: 1.35rem 1rem 1rem;
    }

    #shopify-section-{{ section.id }} .np-title {
      max-width: 13ch;
    }

    #shopify-section-{{ section.id }} .np-title-line {
      font-size: clamp(1.55rem, 8vw, 2rem);
    }

    #shopify-section-{{ section.id }} .np-desc {
      font-size: 0.86rem;
      line-height: 1.45;
    }
  }
</style>

<div id="newsletter-popup-{{ section.id }}" class="np-overlay" aria-hidden="true" role="dialog" aria-label="{{ 'newsletter.popup_label' | t | default: 'Newsletter signup' }}">
  <div class="np-modal" role="document">
    <button type="button" class="np-close" aria-label="{{ 'accessibility.close' | t | default: 'Fechar' }}" data-np-close>&times;</button>

    <div class="np-media">
      <div class="np-image-wrap">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1000 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(max-width: 899px) 100vw, 42vw',
            widths: '375, 550, 750, 900, 1100',
            alt: section.settings.image.alt | default: section.settings.title_line1
          }}
        {% else %}
          <div class="np-placeholder-bg">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'np-placeholder' }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="np-form-panel">
<div class="np-inner">
        <div id="np-form-wrap-{{ section.id }}">
          {%- if section.settings.kicker != blank -%}
            <div class="np-kicker">
              <span class="np-kicker-dot" aria-hidden="true"></span>
              <span>{{ section.settings.kicker }}</span>
            </div>
          {%- endif -%}

          <div class="np-copy">
            <h2 class="np-title">
              <span class="np-title-line">{{ section.settings.title_line1 | default: 'Entre para' }}</span>
              <span class="np-title-line np-title-line--alt">{{ section.settings.title_line2 | default: 'a nossa lista' }}</span>
            </h2>

            <p class="np-desc">
              {{ section.settings.description | default: 'Receba novidades, lançamentos e condições especiais antes de todo mundo.' }}
            </p>
          </div>

          {% assign np_form_id = 'np-form-' | append: section.id %}
          {% form 'customer', id: np_form_id, class: 'np-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input
              type="email"
              name="contact[email]"
              class="np-input"
              placeholder="{{ section.settings.placeholder | default: 'Seu melhor e-mail' }}"
              required
              autocomplete="email"
              aria-label="{{ section.settings.placeholder | default: 'Seu melhor e-mail' }}"
            >
            <button type="submit" class="np-submit">
              {{ section.settings.button_text | default: 'Quero entrar' }}
            </button>
          {% endform %}

          <div class="np-footer">
            <button type="button" class="np-no-thanks" data-np-close>
              {{ section.settings.dismiss_text | default: 'Agora não' }}
            </button>

            <div class="np-links">
              <a href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}">Política de Privacidade</a>
              <a href="{{ section.settings.terms_url | default: '/policies/terms-of-service' }}">Termos de Uso</a>
            </div>
          </div>
        </div>

        <div id="np-success-{{ section.id }}" class="np-success">
          <h3>{{ section.settings.success_title | default: 'Você entrou!' }}</h3>
          <p>{{ section.settings.success_message | default: 'Em breve você recebe novidades e condições especiais.' }}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="module">
(function() {
  var sectionId = {{ section.id | json }};
  var delaySeconds = {{ section.settings.show_after_seconds | default: 3 }};
  var buttonText = {{ section.settings.button_text | default: 'Quero entrar' | json }};
  var storageKey = 'np_shown_' + sectionId;
  var lockKey = 'newsletter-popup:' + sectionId;
  var openTimer = 0;

  var overlay = document.getElementById('newsletter-popup-' + sectionId);
  if (!overlay && document.currentScript && document.currentScript.closest) {
    var sectionEl = document.currentScript.closest('[id^="shopify-section-"]');
    overlay = sectionEl ? sectionEl.querySelector('.np-overlay') : null;
  }
  if (!overlay) overlay = document.querySelector('.np-overlay');
  if (!overlay) return;

  if (overlay.__npAbortController) overlay.__npAbortController.abort();
  overlay.__npAbortController = new AbortController();
  var signal = overlay.__npAbortController.signal;

  function hasBlockingOverlay() {
    if (document.querySelector('dialog[open], details[scroll-lock][open]')) return true;
    var visiblePopups = document.querySelectorAll('.np-overlay.np-visible');
    for (var i = 0; i < visiblePopups.length; i++) {
      if (visiblePopups[i] !== overlay) return true;
    }
    try {
      if (document.querySelector('[popover]:popover-open')) return true;
    } catch(e) {}
    return false;
  }

  function openPopup() {
    if (overlay.classList.contains('np-visible')) return;
    if (hasBlockingOverlay()) {
      openTimer = setTimeout(openPopup, 1500);
      return;
    }
    window.AMOverlay?.closeAll?.({ except: overlay });
    overlay.classList.add('np-visible');
    overlay.setAttribute('aria-hidden', 'false');
    if (window.AMScrollLock && typeof window.AMScrollLock.lock === 'function') {
      window.AMScrollLock.lock(lockKey);
    } else {
      document.body.style.overflow = 'hidden';
    }
  }

  function closePopup(persist) {
    overlay.classList.remove('np-visible');
    overlay.setAttribute('aria-hidden', 'true');
    if (window.AMScrollLock && typeof window.AMScrollLock.unlock === 'function') {
      window.AMScrollLock.unlock(lockKey);
    } else {
      document.body.style.overflow = '';
    }
    if (persist !== false) {
      try { sessionStorage.setItem(storageKey, '1'); } catch(e) {}
    }
  }

  overlay.querySelectorAll('[data-np-close]').forEach(function(btn) {
    btn.addEventListener('click', closePopup, { signal: signal });
  });

  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closePopup();
  }, { signal: signal });

  overlay.addEventListener('am:overlay:close', closePopup, { signal: signal });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.classList.contains('np-visible')) closePopup();
  }, { passive: true, signal: signal });

  var alreadyShown = false;
  try { alreadyShown = sessionStorage.getItem(storageKey) === '1'; } catch(e) {}

  if (!alreadyShown) {
    function scheduleOpen() {
      openTimer = setTimeout(openPopup, delaySeconds * 1000);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scheduleOpen, { once: true, signal: signal });
    } else {
      scheduleOpen();
    }
  }

  document.addEventListener('shopify:section:unload', function(e) {
    if (!e.target || !e.target.contains(overlay)) return;
    if (openTimer) clearTimeout(openTimer);
    closePopup(false);
    overlay.__npAbortController.abort();
  }, { signal: signal });

  var form = overlay.querySelector('form.np-form');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var formWrap = document.getElementById('np-form-wrap-' + sectionId);
      var successEl = document.getElementById('np-success-' + sectionId);
      var submitBtn = form.querySelector('.np-submit');
      if (!formWrap || !successEl) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '...';
      }

      var formData = new FormData(form);
      var formAction = form.getAttribute('action') || '/contact';

      fetch(formAction, {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
      })
      .then(function() {
        formWrap.style.display = 'none';
        successEl.style.display = 'block';
        try { sessionStorage.setItem(storageKey, '1'); } catch(e) {}
      })
      .catch(function() {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = buttonText;
        }
      });
    }, { signal: signal });
  }
})();
</script>

{% schema %}
{
  "name": "Newsletter Pop-up",
  "tag": "section",
  "class": "newsletter-popup-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem do pop-up"
    },
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "A MARCA"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Título linha 1",
      "default": "Entre para"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Título linha 2",
      "default": "a nossa lista"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição",
      "default": "Receba novidades, lançamentos e condições especiais antes de todo mundo."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder do e-mail",
      "default": "Seu melhor e-mail"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto do botão",
      "default": "Quero entrar"
    },
    {
      "type": "text",
      "id": "dismiss_text",
      "label": "Texto recusar",
      "default": "Agora não"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "URL política de privacidade"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "URL termos de uso"
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fundo do modal",
      "default": "#F3F1EC"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Fundo do formulário",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor de destaque",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Comportamento"
    },
    {
      "type": "range",
      "id": "show_after_seconds",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Mostrar após",
      "default": 3
    },
    {
      "type": "header",
      "content": "Mensagem de sucesso"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Título sucesso",
      "default": "Você entrou!"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Mensagem sucesso",
      "default": "Em breve você recebe novidades e condições especiais."
    }
  ],
  "presets": [
    {
      "name": "Newsletter Pop-up Editorial"
    }
  ]
}
{% endschema %}
