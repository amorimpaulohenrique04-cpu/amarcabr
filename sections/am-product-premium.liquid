      invalidate();
    });
    input.addEventListener('keydown', function(event) {
      if (event.key === 'Enter') { event.preventDefault(); if (!button.disabled) calculate(); }
    });
    button.addEventListener('click', calculate);
    form.addEventListener('change', function(event) {
      if (event.target.matches('.pp-variant-group input, [name="quantity"], [name="selling_plan"]')) invalidate();
    });
    form.addEventListener('input', function(event) { if (event.target.matches('[name="quantity"]')) invalidate(); });
    window.addEventListener('pageshow', function(event) { if (event.persisted) invalidate(); });
    document.addEventListener('shopify:section:unload', function(event) {
      if (event.target && event.target.contains(root)) invalidate();
    });
  }

})();

