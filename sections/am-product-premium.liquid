      var key = [zip, chosen.id, chosen.quantity, chosen.plan].join(':');
      var cached = cache.get(key);
      if (cached && Date.now() - cached.created < 120000) { render(cached); return; }
      var version = requestVersion;
      var controller = new AbortController();
      activeRequest = controller;
      button.disabled = true;
      root.setAttribute('aria-busy', 'true');
      status.textContent = 'Consultando opções de entrega…';
      var timeout = setTimeout(function() { controller.abort(); }, 45000);
      try {
        var address = await addressFromZip(zip, controller.signal);
        var line = { merchandiseId: 'gid://shopify/ProductVariant/' + chosen.id, quantity: chosen.quantity };
        if (chosen.plan) line.sellingPlanId = 'gid://shopify/SellingPlan/' + chosen.plan;
        var created = await storefront(createQuery, { input: {
          lines: [line], buyerIdentity: { countryCode: 'BR' },
          delivery: { addresses: [{ selected: true, oneTimeUse: true, address: { deliveryAddress: address } }] }
        } }, controller.signal);
        var payload = created[0].data && created[0].data.cartCreate;
        if (!payload || (payload.userErrors && payload.userErrors.length) || !payload.cart) throw new Error('SHIPPING_CART_FAILED');
        var rates = await storefront(ratesQuery, { id: payload.cart.id }, controller.signal);
        var groups = ppShippingGroups(rates);
        var etaByCode = {};
        try {
          etaByCode = await fetchFrenetEta(zip, chosen, groups, controller.signal);
        } catch (etaError) {
          etaByCode = {};
        }
        var quote = {
          groups: groups,
          etaByCode: etaByCode,
          quantity: chosen.quantity,
          created: Date.now(),
          destination: [address.city, address.provinceCode].filter(Boolean).join(', ')
        };
        if (version !== requestVersion) return;
        if (quote.groups.length && quote.groups.every(function(group) { return group.deliveryOptions.length; })) {
          if (cache.size >= 20) cache.delete(cache.keys().next().value);
          cache.set(key, quote);
        }
        render(quote);
      } catch (error) {
        if (version === requestVersion) status.textContent = error.publicMessage || 'Não foi possível consultar a entrega agora. Tente novamente em instantes.';
