    });

    /* ================================================

       ZOOM INLINE — CLICK TO ACTIVATE

       ================================================ */

    var isTouchDevice = window.matchMedia('(hover: none)').matches;

    var zoomItems = root.querySelectorAll('.pp-media-item--has-zoom');

    function deactivateAllZooms() {

      var activeItem = root.querySelector('.pp-media-item--has-zoom.is-zoom-active');

      if (activeItem) {

        activeItem.classList.remove('is-zoom-active');

        var layer = activeItem.querySelector('.pp-media-item__zoom-layer');

        if (layer) layer.style.backgroundPosition = 'center center';

        activeItem._ppZoomActive = false;

      }

    }

    zoomItems.forEach(function(item) {

      var zoomLayer = item.querySelector('.pp-media-item__zoom-layer');

      if (!zoomLayer) return;

      item._ppZoomActive = false;

      item._ppBgPosX = 50;

      item._ppBgPosY = 50;

      item._ppLastTouchX = 0;

      item._ppLastTouchY = 0;

      item._ppHdPreloaded = false;

      function preloadHD() {

        if (item._ppHdPreloaded) return;

        var hdSrc = item.getAttribute('data-pp-zoom-src');

        if (hdSrc) {

          var preload = new Image();

          preload.src = hdSrc;

          item._ppHdPreloaded = true;

        }

      }

      function activateZoom(clientX, clientY) {

        deactivateAllZooms();

        preloadHD();

        item._ppZoomActive = true;

        item.classList.add('is-zoom-active');

        var rect = item.getBoundingClientRect();

        item._ppBgPosX = ((clientX - rect.left) / rect.width) * 100;

        item._ppBgPosY = ((clientY - rect.top) / rect.height) * 100;

        item._ppBgPosX = Math.max(0, Math.min(100, item._ppBgPosX));

        item._ppBgPosY = Math.max(0, Math.min(100, item._ppBgPosY));

        zoomLayer.style.backgroundPosition = item._ppBgPosX + '% ' + item._ppBgPosY + '%';

      }

      function deactivateZoom() {

        item._ppZoomActive = false;

        item.classList.remove('is-zoom-active');

        zoomLayer.style.backgroundPosition = 'center center';

        item._ppBgPosX = 50;

        item._ppBgPosY = 50;

      }

      item.addEventListener('click', function(e) {

        e.preventDefault();

        e.stopPropagation();

        if (!item._ppZoomActive) {

          activateZoom(e.clientX, e.clientY);

        } else {

          deactivateZoom();

        }

      });

      if (!isTouchDevice) {

        item.addEventListener('mousemove', function(e) {

          if (!item._ppZoomActive) return;

          var rect = item.getBoundingClientRect();

          var x = ((e.clientX - rect.left) / rect.width) * 100;

          var y = ((e.clientY - rect.top) / rect.height) * 100;

          x = Math.max(0, Math.min(100, x));

          y = Math.max(0, Math.min(100, y));

          zoomLayer.style.backgroundPosition = x + '% ' + y + '%';

        });

        item.addEventListener('mouseleave', function() {

          if (item._ppZoomActive) {

            deactivateZoom();

          }

        });

      }

      if (isTouchDevice) {

        item.addEventListener('touchstart', function(e) {

          if (!item._ppZoomActive) return;

          if (e.touches.length === 1) {

            item._ppLastTouchX = e.touches[0].clientX;

            item._ppLastTouchY = e.touches[0].clientY;

          }

        }, { passive: true });

        item.addEventListener('touchmove', function(e) {

          if (!item._ppZoomActive) return;

          if (e.touches.length === 1) {

            e.preventDefault();

            var rect = item.getBoundingClientRect();

            var deltaX = (item._ppLastTouchX - e.touches[0].clientX) / rect.width * 100;

            var deltaY = (item._ppLastTouchY - e.touches[0].clientY) / rect.height * 100;

            item._ppBgPosX = Math.max(0, Math.min(100, item._ppBgPosX + deltaX * 0.8));

            item._ppBgPosY = Math.max(0, Math.min(100, item._ppBgPosY + deltaY * 0.8));

            zoomLayer.style.backgroundPosition = item._ppBgPosX + '% ' + item._ppBgPosY + '%';

            item._ppLastTouchX = e.touches[0].clientX;

            item._ppLastTouchY = e.touches[0].clientY;

          }

        }, { passive: false });

      }

    });

    document.addEventListener('click', function(e) {

      var clickedZoomItem = e.target.closest('.pp-media-item--has-zoom');

      if (!clickedZoomItem) {

        deactivateAllZooms();

      }

    });

    var scrollTimer;

    window.addEventListener('scroll', function() {

      clearTimeout(scrollTimer);

      scrollTimer = setTimeout(function() {

        deactivateAllZooms();

      }, 100);

    }, { passive: true });

    document.addEventListener('keydown', function(e) {

      if (e.key === 'Escape') {

        deactivateAllZooms();

      }

    });

  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPdp, { once: true });
  } else {
    initPdp();
  }

  function updateBtn(btn, text, disabled) { if(btn){ btn.textContent = text; btn.disabled = disabled; } }

  function formatMoney(cents) { return (cents / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }

  function showToast(msg) { var toast = document.getElementById('pp-toast-{{ section_id }}'); if (!toast) { toast = document.createElement('div'); toast.id = 'pp-toast-{{ section_id }}'; toast.style.cssText = 'position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#333;color:#fff;padding:12px 24px;border-radius:8px;font-size:14px;z-index:99999;opacity:0;transition:opacity .3s'; document.body.appendChild(toast); } toast.textContent = msg; toast.style.opacity = '1'; setTimeout(function(){ toast.style.opacity = '0'; }, 3500); }

  /* PDP SHIPPING — Storefront 2026-07, isolated quote cart (no /cart mutations).
     https://shopify.dev/docs/api/storefront/2026-07/mutations/cartCreate
     https://shopify.dev/docs/storefronts/headless/building-with-the-storefront-api/defer
     No customer identity, checkout navigation, cookies or persistent cart IDs are used.
  */
  function ppParseShippingPayload(text, contentType) {
    var payloads;
    if (/multipart\/mixed/i.test(contentType || '')) {
      var match = /boundary\s*=\s*(?:"([^"]+)"|([^;\s]+))/i.exec(contentType);
      if (!match) throw new Error('MISSING_MULTIPART_BOUNDARY');
      var boundary = match[1] || match[2];
      if (!text.trim().endsWith('--' + boundary + '--')) throw new Error('INCOMPLETE_SHIPPING_RESPONSE');
      payloads = text.split('--' + boundary).slice(1).filter(function(part) {
        return part.trim() && part.trim() !== '--';
      }).map(function(part) {
        var split = /\r?\n\r?\n/.exec(part);
        if (!split) throw new Error('INVALID_MULTIPART_PART');
        return JSON.parse(part.slice(split.index + split[0].length).trim());
      });
    } else { payloads = [JSON.parse(text)]; }
    if (!payloads.length || payloads[payloads.length - 1].hasNext === true) throw new Error('INCOMPLETE_SHIPPING_RESPONSE');
    payloads.forEach(function(payload) {
      if (payload.errors && payload.errors.length) throw new Error('STOREFRONT_GRAPHQL_ERROR');
      (payload.incremental || []).forEach(function(part) {
        if (part.errors && part.errors.length) throw new Error('STOREFRONT_GRAPHQL_ERROR');
      });
    });
    return payloads;
  }

  function ppShippingGroups(payloads) {
    var connection;
    payloads.forEach(function(payload) {
      if (payload.data && payload.data.cart && payload.data.cart.deliveryGroups) connection = payload.data.cart.deliveryGroups;
      (payload.incremental || []).forEach(function(part) {
        if (part.data && part.data.deliveryGroups) connection = part.data.deliveryGroups;
        if (part.data && part.data.cart && part.data.cart.deliveryGroups) connection = part.data.cart.deliveryGroups;
      });
    });
    if (!connection || (connection.pageInfo && connection.pageInfo.hasNextPage)) throw new Error('INCOMPLETE_SHIPPING_GROUPS');
    var groups = connection.nodes || [];
    groups.forEach(function(group) {
      if (!Array.isArray(group.deliveryOptions)) throw new Error('INVALID_SHIPPING_OPTIONS');
      group.deliveryOptions.forEach(function(option) {
        if (!option.estimatedCost || option.estimatedCost.amount === null || option.estimatedCost.amount === '' ||
            !Number.isFinite(Number(option.estimatedCost.amount)) || Number(option.estimatedCost.amount) < 0 ||
            !/^[A-Z]{3}$/.test(option.estimatedCost.currencyCode || '')) throw new Error('INVALID_SHIPPING_PRICE');
      });
    });
    return groups;
  }

  function initPdpShipping(root, form, variants, etaProxyUrl) {
    if (!root || !form || root.dataset.ppShippingReady) return;
    root.dataset.ppShippingReady = 'true';
    var input = root.querySelector('input');
    var button = root.querySelector('[data-pp-zip-button]');
    var status = root.querySelector('[role="status"]');
    var optionsRoot = root.querySelector('[data-pp-zip-options]');
    var cache = new Map();
    var activeRequest = null;
    var requestVersion = 0;
    var createQuery = 'mutation PdpShippingCart($input: CartInput!) { cartCreate(input: $input) { cart { id } userErrors { field message code } } }';
    var ratesQuery = 'query PdpShippingRates($id: ID!) { cart(id: $id) { id ...PdpCarrierRates @defer } } fragment PdpCarrierRates on Cart { deliveryGroups(first: 10, withCarrierRates: true) { nodes { id deliveryOptions { code handle title description deliveryMethodType estimatedCost { amount currencyCode } } } pageInfo { hasNextPage } } }';

    function node(tag, className, text) {
      var element = document.createElement(tag);
      if (className) element.className = className;
      if (text !== undefined) element.textContent = text;
      return element;
    }
    function invalidate() {
      requestVersion += 1;
      if (activeRequest) activeRequest.abort();
      activeRequest = null;
      button.disabled = false;
      root.removeAttribute('aria-busy');
      input.removeAttribute('aria-invalid');
      status.textContent = '';
      optionsRoot.replaceChildren();
    }
    function selection() {
      var hiddenId = form.querySelector('input[name="id"]');
      var chosen = Array.from(form.querySelectorAll('.pp-variant-group')).map(function(group) {
        var checked = group.querySelector('input:checked');
        return checked ? checked.value : null;
      });
      var variant = variants.find(function(item) {
        return hiddenId && String(item.id) === hiddenId.value && (!chosen.length || item.options.every(function(value, index) { return value === chosen[index]; }));
      });
      var quantityInput = form.querySelector('[name="quantity"]');
      var quantity = quantityInput ? Number(quantityInput.value) : 1;
      if (!Number.isInteger(quantity) || quantity < 1 || !variant || !variant.available) return null;
      var plan = form.querySelector('[name="selling_plan"]');
      var rawWeight = Number(variant.grams != null ? variant.grams : variant.weight);
      if (!Number.isFinite(rawWeight) || rawWeight < 0) rawWeight = 0;
      var rawPrice = Number(variant.price);
      if (!Number.isFinite(rawPrice) || rawPrice < 0) rawPrice = 0;
      return {
        id: String(variant.id),
        quantity: quantity,
        plan: plan && plan.value ? plan.value : '',
        sku: variant.sku || '',
        weightGrams: rawWeight,
        unitPriceCents: rawPrice
      };
    }
    async function storefront(query, variables, signal) {
      var response = await fetch('/api/2026-07/graphql.json', {
        method: 'POST', credentials: 'omit', signal: signal,
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json, multipart/mixed; deferSpec=20220824' },
        body: JSON.stringify({ query: query, variables: variables })
      });
      if (!response.ok) throw new Error('STOREFRONT_HTTP_' + response.status);
      return ppParseShippingPayload(await response.text(), response.headers.get('content-type'));
    }
    function shippingCodes(groups) {
      var codes = [];
      groups.forEach(function(group) {
        (group.deliveryOptions || []).forEach(function(option) {
          if (option.code && codes.indexOf(option.code) === -1) codes.push(option.code);
        });
      });
      return codes;
    }

    async function fetchFrenetEta(zip, chosen, groups, signal) {
      if (!etaProxyUrl || typeof etaProxyUrl !== 'string' || !/^https:\/\//i.test(etaProxyUrl)) return {};

      var codes = shippingCodes(groups);
      if (!codes.length) return {};

      var invoiceValue = (chosen.unitPriceCents * chosen.quantity) / 100;
      var response = await fetch(etaProxyUrl, {
        method: 'POST',
        mode: 'cors',
        credentials: 'omit',
        signal: signal,
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          recipientZip: zip,
          invoiceValue: invoiceValue,
          serviceCodes: codes,
          items: [{
            sku: chosen.sku || '',
            weightGrams: chosen.weightGrams || 0,
            quantity: chosen.quantity
          }]
        })
      });

      if (!response.ok) return {};

      var payload = await response.json();
      if (!payload || !Array.isArray(payload.quotes)) return {};

      return payload.quotes.reduce(function(map, item) {
        if (!item || !item.code) return map;
        var days = Number(item.deliveryTime);
        if (!Number.isFinite(days) || days < 0) return map;
        map[String(item.code)] = {
          days: days,
          carrier: item.carrier || '',
          service: item.service || ''
        };
        return map;
      }, {});
    }

    async function addressFromZip(zip, signal) {
      var address = { countryCode: 'BR', zip: zip.slice(0, 5) + '-' + zip.slice(5) };
      var controller = new AbortController();
      var abort = function() { controller.abort(); };
      signal.addEventListener('abort', abort, { once: true });
      var timeout = setTimeout(abort, 7000);
      try {
        // Only the typed CEP is sent to ViaCEP to resolve city and state.
        var response = await fetch('https://viacep.com.br/ws/' + zip + '/json/', { signal: controller.signal, credentials: 'omit' });
        if (response.ok) {
          var data = await response.json();
          if (data.erro) {
            var error = new Error('INVALID_ZIP');
            error.publicMessage = 'Não encontramos esse CEP. Confira os números e tente novamente.';
            throw error;
          }
          if (/^[A-Z]{2}$/.test(data.uf || '')) address.provinceCode = data.uf;
          if (typeof data.localidade === 'string' && data.localidade) address.city = data.localidade;
          if (typeof data.logradouro === 'string' && data.logradouro) address.address1 = data.logradouro;
        }
      } catch (error) {
        if (error.publicMessage) throw error;
        // If postal lookup is unavailable, Shopify can still attempt the quote using country and CEP.
        if (signal.aborted) throw error;
      } finally {
        clearTimeout(timeout);
        signal.removeEventListener('abort', abort);
      }
      return address;
    }
    function render(quote) {
      optionsRoot.replaceChildren();
      var groups = quote.groups;
      if (!groups.length || groups.some(function(group) { return !group.deliveryOptions.length; })) {
        status.textContent = 'Não encontramos opções de entrega para este CEP. Confira o endereço no checkout.';
        return;
      }
      status.textContent = quote.destination ? 'Entrega para ' + quote.destination : 'Opções de entrega para o CEP informado';
      groups.forEach(function(group, index) {
        if (groups.length > 1) optionsRoot.appendChild(node('p', 'pp-shipping-group', 'Envio ' + (index + 1) + ' de ' + groups.length));
        var list = node('ul', 'pp-shipping-options');
        group.deliveryOptions.forEach(function(option) {
          var row = node('li', 'pp-shipping-option');
          var icon = node('span', 'pp-shipping-option__icon');
          icon.setAttribute('aria-hidden', 'true');
          icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3z"/><path d="M14 9h3.6L21 12.5V16h-7z"/><circle cx="7" cy="17" r="1.7"/><circle cx="17.5" cy="17" r="1.7"/></svg>';
          row.appendChild(icon);
          var info = node('div', 'pp-shipping-option__info');
          info.appendChild(node('span', 'pp-shipping-option__name', option.title || 'Entrega'));

          var eta = quote.etaByCode && option.code ? quote.etaByCode[String(option.code)] : null;
          if (eta && Number.isFinite(eta.days)) {
            var etaText = eta.days === 0
              ? 'Entrega no mesmo dia'
              : 'Prazo estimado: ' + eta.days + (eta.days === 1 ? ' dia útil' : ' dias úteis');
            info.appendChild(node('span', 'pp-shipping-option__eta', etaText));
          }

          if (option.description) {
            var description = node('span', 'pp-shipping-option__description', option.description);
            info.appendChild(description);
          }

          row.appendChild(info);
          var amount = Number(option.estimatedCost.amount);
          var money = amount === 0 ? 'Grátis' : new Intl.NumberFormat('pt-BR', { style: 'currency', currency: option.estimatedCost.currencyCode }).format(amount);
          row.appendChild(node('strong', 'pp-shipping-option__price', money));
          list.appendChild(row);
        });
        optionsRoot.appendChild(list);
      });
    }
    async function calculate() {
      var zip = input.value.replace(/\D/g, '');
      invalidate();
      if (!/^\d{8}$/.test(zip)) {
