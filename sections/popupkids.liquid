  <script>
    (() => {
      const root = document.getElementById({{ popup_id | json }});
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const panel = root.querySelector('.cog-modal__panel');
      const closers = root.querySelectorAll('[data-cog-close]');
      const storageKey = root.dataset.storageKey;
      const frequency = root.dataset.frequency || 'session';
      const hideDays = Number(root.dataset.hideDays || 7);
      const trigger = root.dataset.trigger || 'delay';
      const delay = Number(root.dataset.delay || 4000);
      const scrollPercent = Number(root.dataset.scrollPercent || 30);

      let previousFocus = null;
      let opened = false;
      let triggerBound = false;
      let imagesHydrated = false;

      const now = () => Date.now();

      function canShow() {
        if (window.Shopify && Shopify.designMode) return true;

        try {
          if (frequency === 'always') return true;

          if (frequency === 'session') {
            return sessionStorage.getItem(storageKey) !== '1';
          }

          if (frequency === 'days') {
            const last = Number(localStorage.getItem(storageKey) || 0);
            return !last || now() - last >= hideDays * 86400000;
          }
        } catch (e) {}

        return true;
      }

      function remember() {
        if (window.Shopify && Shopify.designMode) return;

        try {
          if (frequency === 'session') {
            sessionStorage.setItem(storageKey, '1');
          } else if (frequency === 'days') {
            localStorage.setItem(storageKey, String(now()));
          }
        } catch (e) {}
      }

      function getFocusable() {
        return [...panel.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )].filter((el) => el.offsetParent !== null);
      }

      function onKeydown(event) {
        if (!opened) return;

        if (event.key === 'Escape') {
          close(true);
          return;
        }

        if (event.key !== 'Tab') return;

        const focusables = getFocusable();
        if (!focusables.length) {
          event.preventDefault();
          panel.focus();
          return;
        }

        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }

      function open() {
        if (opened || !canShow()) return;

        if (!imagesHydrated) {
          root.querySelectorAll('[data-cog-srcset]').forEach((element) => {
            element.srcset = element.dataset.cogSrcset;
            element.removeAttribute('data-cog-srcset');
          });
          root.querySelectorAll('img[data-cog-src]').forEach((image) => {
            image.src = image.dataset.cogSrc;
            image.removeAttribute('data-cog-src');
          });
          imagesHydrated = true;
        }

        opened = true;
        previousFocus = document.activeElement;
        root.classList.add('is-open');
        root.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('cog-modal-lock');
        document.addEventListener('keydown', onKeydown);

        requestAnimationFrame(() => {
          const focusables = getFocusable();
          (focusables[0] || panel).focus({ preventScroll: true });
        });
      }

      function close(shouldRemember = true) {
        if (!opened) return;

        opened = false;
        root.classList.remove('is-open');
        root.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('cog-modal-lock');
        document.removeEventListener('keydown', onKeydown);

        if (shouldRemember) remember();

        if (previousFocus && typeof previousFocus.focus === 'function') {
          previousFocus.focus({ preventScroll: true });
        }
      }

      closers.forEach((el) => el.addEventListener('click', () => close(true)));

      function bindScrollTrigger() {
        if (triggerBound) return;
        triggerBound = true;

        const onScroll = () => {
          const doc = document.documentElement;
          const max = Math.max(1, doc.scrollHeight - window.innerHeight);
          const progress = (window.scrollY / max) * 100;

          if (progress >= scrollPercent) {
            window.removeEventListener('scroll', onScroll);
            open();
          }
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      function bindExitTrigger() {
        if (triggerBound) return;
        triggerBound = true;

        const onMouseLeave = (event) => {
          if (event.clientY <= 8) {
            document.removeEventListener('mouseleave', onMouseLeave);
            open();
          }
        };

        document.addEventListener('mouseleave', onMouseLeave);
      }

      function bindDelayedInteractionTrigger() {
        let delayElapsed = false;
        let interacted = false;

        const cleanup = () => {
          window.removeEventListener('scroll', onIntent);
          document.removeEventListener('pointerdown', onIntent);
          document.removeEventListener('keydown', onIntent);
        };

        const maybeOpen = () => {
          if (!delayElapsed || !interacted) return;
          cleanup();
          open();
        };

        const onIntent = () => {
          interacted = true;
          maybeOpen();
        };

        window.addEventListener('scroll', onIntent, { passive: true, once: true });
        document.addEventListener('pointerdown', onIntent, { passive: true, once: true });
        document.addEventListener('keydown', onIntent, { once: true });

        window.setTimeout(() => {
          delayElapsed = true;
          maybeOpen();
        }, Math.max(5000, delay));
      }

      function schedule() {
        if (!canShow()) return;

        if (trigger === 'scroll') {
          bindScrollTrigger();
        } else if (trigger === 'exit') {
          bindExitTrigger();
        } else {
          bindDelayedInteractionTrigger();
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', schedule, { once: true });
      } else {
        schedule();
      }

      document.addEventListener('shopify:section:select', (event) => {
        if (event.detail?.sectionId === {{ section.id | json }}) open();
      });

      document.addEventListener('shopify:section:deselect', (event) => {
        if (event.detail?.sectionId === {{ section.id | json }}) close(false);
      });

      document.addEventListener('shopify:section:unload', (event) => {
        if (event.detail?.sectionId === {{ section.id | json }}) {
          document.documentElement.classList.remove('cog-modal-lock');
          document.removeEventListener('keydown', onKeydown);
        }
      });
    })();
  </script>
{% endif %}

