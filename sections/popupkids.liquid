{% comment %}
  A MARCA — Popup Pré-venda Child of God
  Construído em Liquid + HTML + CSS + JS.
  Nenhum texto/CTA/decoração depende de uma arte achatada.
  Apenas a fotografia editorial é uma imagem de conteúdo.

  Instalação:
  Sections > Add a new section > popup-child-of-god-built
  Cole este arquivo inteiro e adicione a seção no Theme Editor.
{% endcomment %}

{% liquid
  assign popup_id = 'amarca-cog-' | append: section.id
  assign product = section.settings.product

  assign campaign_image_desktop = section.settings.campaign_image
  if campaign_image_desktop == blank and product != blank
    assign campaign_image_desktop = product.featured_image
  endif

  assign campaign_image_mobile = section.settings.campaign_image_mobile
  if campaign_image_mobile == blank
    assign campaign_image_mobile = campaign_image_desktop
  endif

  assign cta_url = section.settings.cta_link
  if cta_url == blank and product != blank
    assign cta_url = product.url
  endif

  assign price_output = section.settings.price_text
  if price_output == blank and product != blank
    assign price_output = product.price | money
  endif
  if price_output == blank
    assign price_output = 'R$ 149,90'
  endif
%}

{% if section.settings.enabled %}
  <div
    id="{{ popup_id }}"
    class="cog-modal"
    data-cog-modal
    data-delay="{{ section.settings.delay_seconds | times: 1000 }}"
    data-trigger="{{ section.settings.trigger }}"
    data-scroll-percent="{{ section.settings.scroll_percent }}"
    data-frequency="{{ section.settings.frequency }}"
    data-hide-days="{{ section.settings.hide_days }}"
    data-storage-key="amarca-cog-{{ section.id }}"
    aria-hidden="true"
  >
    <div class="cog-modal__backdrop" data-cog-close></div>

    <section
      class="cog-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ popup_id }}-title"
      tabindex="-1"
    >
      <button class="cog-modal__close" type="button" data-cog-close aria-label="Fechar">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 5 19 19M19 5 5 19" />
        </svg>
      </button>

      <div class="cog-modal__media">
        <div class="cog-modal__paper cog-modal__paper--back" aria-hidden="true"></div>

        <div class="cog-modal__photo-frame">
          {% if campaign_image_desktop != blank %}
            <picture class="cog-modal__picture">
              {% if campaign_image_mobile != blank %}
                <source
                  media="(max-width: 899px)"
                  data-cog-srcset="{{ campaign_image_mobile | image_url: width: 480 }} 480w, {{ campaign_image_mobile | image_url: width: 640 }} 640w, {{ campaign_image_mobile | image_url: width: 800 }} 800w, {{ campaign_image_mobile | image_url: width: 1000 }} 1000w"
                  sizes="90vw"
                >
              {% endif %}
              <img
                class="cog-modal__photo"
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                data-cog-src="{{ campaign_image_desktop | image_url: width: 1400 }}"
                data-cog-srcset="{{ campaign_image_desktop | image_url: width: 640 }} 640w, {{ campaign_image_desktop | image_url: width: 800 }} 800w, {{ campaign_image_desktop | image_url: width: 1000 }} 1000w, {{ campaign_image_desktop | image_url: width: 1200 }} 1200w, {{ campaign_image_desktop | image_url: width: 1400 }} 1400w"
                sizes="(max-width: 899px) 90vw, 54vw"
                width="{{ campaign_image_desktop.width }}"
                height="{{ campaign_image_desktop.height }}"
                alt="{{ section.settings.campaign_image_alt | escape }}"
                decoding="async"
              >
            </picture>
          {% else %}
            <div class="cog-modal__photo-placeholder">
              <span>Adicione a foto da campanha</span>
            </div>
          {% endif %}
        </div>

        {% if section.settings.show_crown %}
          <svg class="cog-doodle cog-doodle--crown" viewBox="0 0 120 100" aria-hidden="true">
            <path d="M18 77 11 26l30 24L58 12l23 38 29-28-9 57Z"/>
            <path d="M23 86c23 5 49 4 73 0"/>
          </svg>
        {% endif %}

        {% if section.settings.show_star %}
          <svg class="cog-doodle cog-doodle--star" viewBox="0 0 110 110" aria-hidden="true">
            <path d="M54 5 64 37 92 17 77 45 108 52 76 61 96 89 66 72 56 105 47 73 16 94 34 63 4 53 36 45 17 18 47 37Z"/>
          </svg>
        {% endif %}

        {% if section.settings.show_heart %}
          <svg class="cog-doodle cog-doodle--heart" viewBox="0 0 80 70" aria-hidden="true">
            <path d="M40 61S8 43 8 22C8 9 25 4 40 20 55 4 72 9 72 22c0 21-32 39-32 39Z"/>
          </svg>
        {% endif %}

        <div class="cog-doodle cog-doodle--rays" aria-hidden="true">
          <i></i><i></i><i></i>
        </div>

        {% if section.settings.note_text != blank %}
          <div class="cog-modal__note" aria-hidden="true">
            <span>{{ section.settings.note_text | escape | newline_to_br }}</span>
            <svg viewBox="0 0 38 34">
              <path d="M19 29S4 20 4 10c0-7 9-9 15 0 6-9 15-7 15 0 0 10-15 19-15 19Z"/>
            </svg>
          </div>
        {% endif %}
      </div>

      <div class="cog-modal__content">
        <div class="cog-modal__content-inner">
          {% if section.settings.eyebrow != blank %}
            <p class="cog-modal__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}

          <div class="cog-modal__headline-wrap">
            {% if section.settings.headline_image != blank %}
              <img
                class="cog-modal__headline-image"
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
                data-cog-src="{{ section.settings.headline_image | image_url: width: 900 }}"
                data-cog-srcset="{{ section.settings.headline_image | image_url: width: 320 }} 320w, {{ section.settings.headline_image | image_url: width: 480 }} 480w, {{ section.settings.headline_image | image_url: width: 640 }} 640w, {{ section.settings.headline_image | image_url: width: 760 }} 760w, {{ section.settings.headline_image | image_url: width: 900 }} 900w"
                sizes="(max-width: 749px) 78vw, 390px"
                width="{{ section.settings.headline_image.width }}"
                height="{{ section.settings.headline_image.height }}"
                alt="{{ section.settings.headline_alt | escape }}"
                decoding="async"
              >
              <h2 id="{{ popup_id }}-title" class="visually-hidden">
                {{ section.settings.headline_line_1 }} {{ section.settings.headline_line_2 }}
              </h2>
            {% else %}
              <h2 id="{{ popup_id }}-title" class="cog-modal__headline">
                <span>{{ section.settings.headline_line_1 }}</span>
                <span>{{ section.settings.headline_line_2 }}</span>
              </h2>
            {% endif %}
          </div>

          <div class="cog-modal__offer">
            <h3 class="cog-modal__product-title">{{ section.settings.product_title }}</h3>

            {% if section.settings.description != blank %}
              <div class="cog-modal__description">
                {{ section.settings.description }}
              </div>
            {% endif %}

            <div class="cog-modal__price-row">
              <span class="cog-modal__price">{{ price_output }}</span>

              <span class="cog-modal__price-rays" aria-hidden="true">
                <i></i><i></i><i></i>
              </span>
            </div>

            {% if cta_url != blank %}
              <a class="cog-modal__cta" href="{{ cta_url }}">
                <span>{{ section.settings.cta_label }}</span>
                <svg viewBox="0 0 28 18" aria-hidden="true">
                  <path d="M1 9h23M17 2l7 7-7 7"/>
                </svg>
              </a>
            {% else %}
              <button class="cog-modal__cta cog-modal__cta--disabled" type="button" disabled>
                <span>{{ section.settings.cta_label }}</span>
                <svg viewBox="0 0 28 18" aria-hidden="true">
                  <path d="M1 9h23M17 2l7 7-7 7"/>
                </svg>
              </button>
            {% endif %}
          </div>

        </div>
      </div>
    </section>
  </div>

  <style>
    {% if section.settings.headline_font != blank %}
      {{ section.settings.headline_font | font_face: font_display: 'swap' }}
    {% endif %}
    {% if section.settings.body_font != blank %}
      {{ section.settings.body_font | font_face: font_display: 'swap' }}
    {% endif %}

    #{{ popup_id }} {
      --cog-bg: {{ section.settings.background_color }};
      --cog-ink: {{ section.settings.ink_color }};
      --cog-paper: {{ section.settings.paper_color }};
      --cog-accent: {{ section.settings.accent_color }};
      --cog-coral: {{ section.settings.coral_color }};
      --cog-button: {{ section.settings.button_color }};
      --cog-button-text: {{ section.settings.button_text_color }};
      --cog-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      --cog-radius: {{ section.settings.radius }}px;
      --cog-headline-font:
        {% if section.settings.headline_font != blank %}
          {{ section.settings.headline_font.family | json }},
          {{ section.settings.headline_font.fallback_families }}
        {% else %}
          "Arial Rounded MT Bold", "Trebuchet MS", Arial, sans-serif
        {% endif %};
      --cog-body-font:
        {% if section.settings.body_font != blank %}
          {{ section.settings.body_font.family | json }},
          {{ section.settings.body_font.fallback_families }}
        {% else %}
          Inter, Arial, sans-serif
        {% endif %};

      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: grid;
      place-items: center;
      padding: 18px;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      font-family: var(--cog-body-font);
      transition: opacity .18s ease, visibility .18s ease;
    }

    #{{ popup_id }}.is-open {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
    }

    #{{ popup_id }} *,
    #{{ popup_id }} *::before,
    #{{ popup_id }} *::after {
      box-sizing: border-box;
    }

    #{{ popup_id }} .cog-modal__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(18, 15, 12, var(--cog-overlay));
      backdrop-filter: blur({{ section.settings.overlay_blur }}px);
      -webkit-backdrop-filter: blur({{ section.settings.overlay_blur }}px);
    }

    #{{ popup_id }} .cog-modal__panel {
      position: relative;
      z-index: 1;
      height: min(490px, calc(100svh - 96px), calc(57.88vw - 30px));
      width: auto;
      aspect-ratio: 1218 / 705;
      display: grid;
      grid-template-columns: 57% 43%;
      overflow: hidden;
      border: 0;
      border-radius: var(--cog-radius);
      background: var(--cog-bg);
      box-shadow: 0 18px 60px rgba(31, 21, 11, .19);
      outline: none;
      transform: translateY(8px) scale(.995);
      transition: transform .22s cubic-bezier(.2,.75,.2,1);
    }

    #{{ popup_id }}.is-open .cog-modal__panel {
      transform: translateY(0) scale(1);
    }

    #{{ popup_id }} .cog-modal__close {
      position: absolute;
      top: 9px;
      right: 9px;
      z-index: 40;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--cog-paper);
      cursor: pointer;
      opacity: .9;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
      transition: opacity .15s ease, transform .15s ease, background-color .15s ease;
    }

    #{{ popup_id }} .cog-modal__close:hover {
      opacity: 1;
      transform: rotate(4deg);
    }

    #{{ popup_id }} .cog-modal__close svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.55;
      stroke-linecap: round;
    }

    #{{ popup_id }} .cog-modal__media {
      position: relative;
      min-width: 0;
      min-height: 0;
      height: 100%;
      padding: 14px 0 14px 14px;
      isolation: isolate;
    }

    #{{ popup_id }} .cog-modal__paper--back {
      position: absolute;
      z-index: -1;
      inset: 19px 3.5% 20px 21px;
      background: color-mix(in srgb, var(--cog-paper) 91%, var(--cog-bg));
      clip-path: polygon(
        2% 3%, 18% 2%, 36% 3%, 54% 1%, 74% 3%, 97% 2%,
        99% 19%, 98% 39%, 100% 59%, 97% 80%, 98% 97%,
        80% 96%, 62% 99%, 44% 97%, 24% 99%, 2% 96%,
        1% 78%, 2% 57%, 0% 36%
      );
      transform: rotate(-.45deg);
      opacity: .45;
    }

    #{{ popup_id }} .cog-modal__photo-frame {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 0;
      overflow: hidden;
      border: 0;
      outline: 0;
      box-shadow: none;
      background: var(--cog-paper);
      clip-path: polygon(
        2% 3%, 18% 2%, 35% 3%, 52% 1%, 70% 3%, 97% 2%,
        99% 18%, 98% 36%, 100% 54%, 98% 73%, 99% 96%,
        80% 97%, 63% 99%, 47% 97%, 29% 99%, 3% 96%,
        1% 79%, 2% 59%, 0% 41%, 2% 21%
      );
    }

    #{{ popup_id }} .cog-modal__picture {
      display: block;
      width: 100%;
      height: 100%;
    }

    #{{ popup_id }} .cog-modal__picture > img {
      width: 100%;
      height: 100%;
    }

    #{{ popup_id }} .cog-modal__photo {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 0;
      object-fit: cover;
      object-position: {{ section.settings.image_position }};
      background: transparent;
      border: 0;
      outline: 0;
      box-shadow: none;
    }

    #{{ popup_id }} .cog-modal__photo-placeholder {
      width: 100%;
      height: 100%;
      min-height: 0;
      display: grid;
      place-items: center;
      padding: 28px;
      background: var(--cog-paper);
      color: var(--cog-ink);
      font-weight: 650;
      text-align: center;
    }

    #{{ popup_id }} .cog-doodle {
      position: absolute;
      z-index: 3;
      pointer-events: none;
    }

    #{{ popup_id }} .cog-doodle path {
      vector-effect: non-scaling-stroke;
    }

    #{{ popup_id }} .cog-doodle--crown {
      top: 13px;
      left: 13px;
      width: clamp(50px, 4.5vw, 66px);
      overflow: visible;
      transform: rotate(-8deg);
    }

    #{{ popup_id }} .cog-doodle--crown path {
      fill: none;
      stroke: var(--cog-accent);
      stroke-width: 6;
      stroke-linejoin: round;
      stroke-linecap: round;
    }

    #{{ popup_id }} .cog-doodle--star {
      top: 5px;
      right: 7%;
      width: clamp(51px, 4.6vw, 67px);
      transform: rotate(-4deg);
    }

    #{{ popup_id }} .cog-doodle--star path {
      fill: var(--cog-coral);
      stroke: none;
    }

    #{{ popup_id }} .cog-doodle--heart {
      top: 33%;
      left: 1px;
      width: clamp(28px, 2.35vw, 35px);
      transform: rotate(-8deg);
    }

    #{{ popup_id }} .cog-doodle--heart path {
      fill: var(--cog-coral);
    }

    #{{ popup_id }} .cog-doodle--rays {
      top: 37%;
      right: -2px;
      width: 38px;
      height: 44px;
    }

    #{{ popup_id }} .cog-doodle--rays i {
      position: absolute;
      left: 6px;
      width: 25px;
      height: 5px;
      border-radius: 999px;
      background: var(--cog-accent);
      transform-origin: left center;
    }

    #{{ popup_id }} .cog-doodle--rays i:nth-child(1) { top: 5px; transform: rotate(-54deg); }
    #{{ popup_id }} .cog-doodle--rays i:nth-child(2) { top: 20px; transform: rotate(-10deg); }
    #{{ popup_id }} .cog-doodle--rays i:nth-child(3) { top: 35px; transform: rotate(35deg); }

    #{{ popup_id }} .cog-modal__note {
      position: absolute;
      z-index: 6;
      left: 8.5%;
      bottom: 16px;
      width: clamp(118px, 10.4vw, 140px);
      min-height: 84px;
      padding: 12px 13px 10px;
      display: grid;
      align-content: center;
      gap: 2px;
      overflow: visible;
      color: var(--cog-ink);
      background: var(--cog-paper);
      clip-path: polygon(
        5% 0, 95% 3%, 100% 88%, 82% 93%, 64% 100%,
        45% 95%, 24% 99%, 0 89%, 4% 65%, 0 42%, 5% 20%
      );
      transform: rotate(-2.8deg);
      font-family: "Segoe Print", "Bradley Hand", cursive;
      font-size: clamp(13px, 1vw, 16px);
      line-height: 1.08;
      text-align: center;
      pointer-events: none;
    }

    #{{ popup_id }} .cog-modal__note span { display: block; }

    #{{ popup_id }} .cog-modal__note svg {
      width: 22px;
      justify-self: end;
      fill: none;
      stroke: var(--cog-ink);
      stroke-width: 2.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    #{{ popup_id }} .cog-modal__content {
      position: relative;
      min-width: 0;
      min-height: 0;
      height: 100%;
      padding: 26px 22px 22px 28px;
    }

    #{{ popup_id }} .cog-modal__content-inner {
      width: 100%;
      height: 100%;
      max-width: none;
      margin: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    #{{ popup_id }} .cog-modal__eyebrow {
      margin: 0 0 10px;
      color: var(--cog-paper);
      font-size: clamp(8px, .7vw, 10px);
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: .17em;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
    }

    #{{ popup_id }} .cog-modal__headline-wrap {
      width: 100%;
      margin: 0 0 26px;
      overflow: visible;
    }

    #{{ popup_id }} .cog-modal__headline-image {
      display: block;
      width: min(82%, 316px);
      height: auto;
      margin: 0 auto;
      object-fit: contain;
    }

    #{{ popup_id }} .visually-hidden {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }

    #{{ popup_id }} .cog-modal__headline {
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      color: var(--cog-paper);
      font-family: var(--cog-headline-font);
      font-weight: {{ section.settings.headline_weight }};
      font-size: clamp(43px, 4vw, 61px);
      line-height: .88;
      letter-spacing: -.055em;
      text-align: center;
    }

    #{{ popup_id }} .cog-modal__headline span {
      display: block;
      width: max-content;
      max-width: none;
      white-space: nowrap;
    }

    #{{ popup_id }} .cog-modal__offer {
      width: 100%;
      min-width: 0;
    }

    #{{ popup_id }} .cog-modal__product-title {
      margin: 0 0 7px;
      color: var(--cog-paper);
      font-size: clamp(22px, 1.9vw, 28px);
      line-height: 1.02;
      font-weight: 600;
      letter-spacing: -.04em;
      white-space: nowrap;
    }

    #{{ popup_id }} .cog-modal__description {
      max-width: 100%;
      color: var(--cog-paper);
      font-size: clamp(12px, .98vw, 14.5px);
      line-height: 1.22;
      letter-spacing: -.014em;
    }

    #{{ popup_id }} .cog-modal__description p { margin: 0; }
    #{{ popup_id }} .cog-modal__description em { font-style: italic; opacity: .9; }

    #{{ popup_id }} .cog-modal__price-row {
      margin: 14px 0 17px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 13px;
    }

    #{{ popup_id }} .cog-modal__price {
      color: var(--cog-paper);
      font-size: clamp(36px, 3.35vw, 50px);
      line-height: .92;
      font-weight: 400;
      letter-spacing: -.055em;
      white-space: nowrap;
    }

    #{{ popup_id }} .cog-modal__price-rays {
      position: relative;
      width: 40px;
      height: 36px;
      flex: 0 0 40px;
    }

    #{{ popup_id }} .cog-modal__price-rays i {
      position: absolute;
      left: 3px;
      width: 30px;
      height: 4px;
      background: var(--cog-accent);
      border-radius: 999px;
      transform-origin: left center;
    }

    #{{ popup_id }} .cog-modal__price-rays i:nth-child(1) { top: 2px; transform: rotate(-24deg); }
    #{{ popup_id }} .cog-modal__price-rays i:nth-child(2) { top: 16px; transform: rotate(1deg); }
    #{{ popup_id }} .cog-modal__price-rays i:nth-child(3) { top: 30px; transform: rotate(25deg); }

    #{{ popup_id }} .cog-modal__cta {
      width: 100%;
      min-height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      padding: 11px 20px;
      border: 0;
      border-radius: 999px;
      background: var(--cog-button);
      color: var(--cog-button-text);
      text-decoration: none;
      font: 800 clamp(11px, .9vw, 13px)/1 var(--cog-body-font);
      letter-spacing: .12em;
      text-transform: uppercase;
      cursor: pointer;
      transition: transform .18s ease, filter .18s ease;
    }

    #{{ popup_id }} .cog-modal__cta:hover {
      transform: translateY(-1px);
      filter: saturate(.94) brightness(1.015);
    }

    #{{ popup_id }} .cog-modal__cta svg {
      width: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform .18s ease;
    }

    #{{ popup_id }} .cog-modal__cta:hover svg { transform: translateX(3px); }
    #{{ popup_id }} .cog-modal__cta--disabled { opacity: .62; cursor: default; }

    #{{ popup_id }} :focus-visible {
      outline: 2px solid var(--cog-paper);
      outline-offset: 4px;
    }

    html.cog-modal-lock,
    html.cog-modal-lock body {
      overflow: hidden !important;
      overscroll-behavior: none;
    }

    @media (max-width: 1100px) and (min-width: 900px) {
      #{{ popup_id }} .cog-modal__content { padding: 22px 18px 18px 23px; }
      #{{ popup_id }} .cog-modal__headline-wrap { margin-bottom: 20px; }
      #{{ popup_id }} .cog-modal__headline-image { width: min(80%, 280px); }
      #{{ popup_id }} .cog-modal__product-title { font-size: clamp(20px, 2.1vw, 25px); }
      #{{ popup_id }} .cog-modal__price-row { margin: 11px 0 13px; }
      #{{ popup_id }} .cog-modal__cta { min-height: 42px; }
    }

    @media (max-width: 899px) and (orientation: portrait) {
