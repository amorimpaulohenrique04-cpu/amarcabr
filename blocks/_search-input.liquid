
{% comment %}
  Elegant Fashion Search Bar - Shopify Section Implementation
  Cleaned up: Removed hardcoded suggestions to let Shopify's native theme JS handle predictive results.
{% endcomment %}

{%- assign block_settings = block.settings -%}

<div class="fashion-search-section" style="--max-width: {{ block_settings.custom_width }}%;">
  <form action="{{ routes.search_url }}" method="get" role="search" class="fashion-search-form">
    <div class="fashion-search-container" id="FashionSearch--{{ block.id }}">
      <div class="fashion-search-wrapper">
        <span class="fashion-search-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </span>
        
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'content.search_input_placeholder' | t | default: 'SEARCH OUR COLLECTIONS...' }}"
          class="fashion-search-input"
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-owns="predictive-search-results"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-label="{{ 'general.search.search' | t }}"
        >
        <input type="hidden" name="type" value="product">

        <button type="button" class="fashion-search-clear" aria-label="Clear search" style="display: none;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      {% comment %} 
        The results container is left empty for the Theme's Predictive Search JS to populate 
        or is handled by the theme's global search overlay.
      {% endcomment %}
      <div id="predictive-search" class="predictive-search" tabindex="-1"></div>
    </div>
  </form>
</div>

<style>
  .fashion-search-section {
    width: 100%;
    max-width: var(--max-width, 800px);
    margin: 40px auto;
    padding: 0 20px;
  }
  .fashion-search-form {
    position: relative;
    width: 100%;
  }
  .fashion-search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #e5e5e5;
    transition: border-color 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .fashion-search-wrapper:focus-within {
    border-color: #000;
  }
  .fashion-search-icon {
    position: absolute;
    left: 0;
    color: #999;
    display: flex;
    transition: color 0.3s ease;
  }
  .fashion-search-wrapper:focus-within .fashion-search-icon {
    color: #000;
  }
  .fashion-search-input {
    width: 100%;
    background: transparent;
    border: none;
    padding: 24px 0 24px 40px;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    outline: none;
    color: #000;
    font-weight: 300;
  }
  .fashion-search-input::placeholder {
    color: #bbb;
    font-size: 11px;
    letter-spacing: 0.15em;
  }
  .fashion-search-clear {
    position: absolute;
    right: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: #999;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .fashion-search-clear:hover {
    color: #000;
    transform: scale(1.1);
  }

  /* Basic styling for theme-injected predictive search results */
  .predictive-search {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    z-index: 100;
    background: #fff;
    margin-top: 10px;
  }
  
  @media screen and (max-width: 749px) {
    .fashion-search-input {
      padding: 20px 0 20px 36px;
      font-size: 12px;
    }
  }
</style>

<script>
  (function() {
    const initFashionSearch = () => {
      const container = document.querySelector('.fashion-search-container');
      if (!container) return;

      const input = container.querySelector('.fashion-search-input');
      const clearBtn = container.querySelector('.fashion-search-clear');

      input.addEventListener('input', function() {
        clearBtn.style.display = this.value.length > 0 ? 'flex' : 'none';
      });

      clearBtn.addEventListener('click', function() {
        input.value = '';
        this.style.display = 'none';
        input.focus();
        // Trigger a change event so the theme's predictive search knows to clear
        input.dispatchEvent(new Event('input', { bubbles: true }));
      });
    };

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initFashionSearch();
    } else {
      document.addEventListener('DOMContentLoaded', initFashionSearch);
    }
  })();
</script>

{% schema %}
{
  "name": "Elegant Fashion Search",
  "tag": "section",
  "class": "section-fashion-search",
  "settings": [
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Elegant Fashion Search"
    }
  ]
}
{% endschema %}
